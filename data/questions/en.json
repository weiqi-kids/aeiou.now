      "asker_locale": null,
      "target_locale": null,
      "text": "Guess: in which community is the star of the fifteenth night not the lantern but people held to be possessed by ancestral spirits, carried through the streets and pierced with blades without bleeding?",
      "options": [
        {
          "id": "id",
          "emoji": "🇮🇩",
          "label": "Indonesia"
        },
        {
          "id": "zh-TW",
          "emoji": "🇹🇼",
