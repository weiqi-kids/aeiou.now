      "asker_locale": null,
      "target_locale": null,
      "text": "Adivinhe: em qual comunidade o primeiro dia do Ramadã só é anunciado depois de o governo se reunir na véspera, pesando as observações da lua contra o cálculo?",
      "options": [
        {
          "id": "id",
          "emoji": "🇮🇩",
          "label": "Indonésia"
        },
        {
          "id": "hi",
