---
// 源自 new-astro-site 模板,依 track-b.md 增修:
// - lang 依 LOCALE
// - GA4:PUBLIC_GA4_ID 有值才輸出 gtag(googletagmanager.com 是守門唯一外部例外);未設完全不輸出
// - 站內導覽(nav.home / nav.rankings)
// - 移除 sitemap <link>(sitemap 提交屬明確延後,M1 不產 sitemap)
//
// 2026-08-11 資訊架構重做:
//   ① 頁尾原本列出七語系自稱(繁體中文 / English / 日本語 …)——結構性錯誤,已整塊移除。
//      七個語系是七個各自獨立的站(各自 repo、各自子網域,每次 build 只吃一個 LOCALE),
//      打開日文站的讀者從頭到尾只會看到日文;「本站有七種語言」是後台的事,不是給讀者看的資訊。
//   ② 刊頭的標語(footer.tagline)與關於頁一併移除:那些文案是前一輪自行編寫的,非用戶提供。
import '../styles/variables.css';
import '../styles/global.css';
import { LOCALE } from '../lib/config.mjs';
import { t } from '../lib/i18n.mjs';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 站內絕對路徑一律用 base 組:GitHub Pages 專案站有 base path,不能掉到主機根目錄。
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const GA4_ID = import.meta.env.PUBLIC_GA4_ID || '';

const path = Astro.url.pathname;
const nav = [
  { href: base, label: t('nav.home'), current: path === base || `${path}/` === base },
  {
    href: `${base}rankings/24h/`,
    label: t('nav.rankings'),
    current: path.startsWith(`${base}rankings`),
  },
];
---

<!doctype html>
<html lang={LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {GA4_ID && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
    )}
    {GA4_ID && (
      <script is:inline define:vars={{ GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', GA4_ID);
      </script>
    )}
  </head>
  <body>
    <header class="masthead">
      <div class="container masthead-inner">
        <a class="wordmark" href={base}>
          <span class="wordmark-name">aeiou.now</span>
        </a>
        <nav class="site-nav" aria-label="site">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-name">aeiou.now</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .masthead {
    background: var(--color-white);
    border-block-end: 0.0625rem solid var(--color-line-strong);
  }
  .masthead-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding-block: 0.875rem;
  }
  .wordmark {
    text-decoration: none;
    color: var(--color-text);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }
  .wordmark-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--color-primary);
  }
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .site-nav a {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    text-decoration: none;
    padding-block: 0.125rem;
    border-block-end: 0.125rem solid transparent;
  }
  .site-nav a:hover {
    color: var(--color-accent-dark);
  }
  .site-nav a[aria-current='page'] {
    color: var(--color-text);
    border-block-end-color: var(--color-accent);
  }

  main {
    flex: 1 0 auto;
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(3rem, 7vw, 5rem);
  }

  .site-footer {
    background: var(--color-primary-deep);
    color: var(--color-primary-line);
    padding-block: 2rem;
  }
  .footer-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-white);
    margin: 0;
  }
</style>
