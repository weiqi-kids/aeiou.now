---
// 源自 new-astro-site 模板,依 track-b.md 增修:
// - lang 依 LOCALE
// - GA4:PUBLIC_GA4_ID 有值才輸出 gtag(googletagmanager.com 是守門唯一外部例外);未設完全不輸出
// - 站內導覽(nav.home / nav.rankings / nav.about)
// - 移除 sitemap <link>(sitemap 提交屬明確延後,M1 不產 sitemap)
import '../styles/variables.css';
import '../styles/global.css';
import { LOCALE } from '../lib/config.mjs';
import { t } from '../lib/i18n.mjs';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 站內絕對路徑一律用 base 組:GitHub Pages 專案站有 base path,不能掉到主機根目錄。
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const GA4_ID = import.meta.env.PUBLIC_GA4_ID || '';
---

<!doctype html>
<html lang={LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {GA4_ID && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
    )}
    {GA4_ID && (
      <script is:inline define:vars={{ GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', GA4_ID);
      </script>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={base}>aeiou.now</a>
        <nav class="site-nav" aria-label="site">
          <a href={base}>{t('nav.home')}</a>
          <a href={`${base}rankings/24h/`}>{t('nav.rankings')}</a>
          <a href={`${base}about/`}>{t('nav.about')}</a>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <small>aeiou.now · {t('footer.tagline')}</small>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    background: var(--color-primary);
    color: var(--color-white);
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.75rem;
  }
  .brand {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-white);
    text-decoration: none;
  }
  .site-nav {
    display: flex;
    gap: 1.25rem;
  }
  .site-nav a {
    color: var(--color-white);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .site-nav a:hover {
    color: var(--color-bg-light);
    text-decoration: underline;
  }
  main {
    padding-block: 2rem 3rem;
  }
  .site-footer {
    border-top: 1px solid var(--color-line);
    padding-block: 1.5rem;
    color: var(--color-ink-soft);
  }
</style>
