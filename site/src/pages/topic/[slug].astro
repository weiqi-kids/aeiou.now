---
// Topic 頁 = 一個看板。版面(2026-08-11 用戶拍板):
//
//   ┌───────────────────────────────────────────────┐
//   │ header:cover 圖 + 七語言並陳 + 🌎 連結           │ ← 第一屏(整幅寬,滿一個視窗高)
//   ├───────────────────────┬───────────────────────┤
//   │ 左 50%                 │ 右 50%                │
//   │  ├ 📍 #nearby(上半)    │  💬 #talking          │
//   │  └ 🎉 #events(下半)    │  (整欄高)              │
//   └───────────────────────┴───────────────────────┘
//   🌎 全世界怎麼過 / 🌎 問世界入口 / 歷史精華 在三區塊之外(整幅寬)
//
// 2026-08-11 的修正史:
//   ① 資訊架構:討論回到主位。更早的版本把「全世界怎麼過」做成招牌大圖、討論縮成小面板,
//      那是雜誌文章網站的排法;這是主題頁論壇,討論串就是內容本身。
//   ② 版面:🔥 熱門趨勢(七個時窗切換)整區移除。時窗切換屬**排行榜層**,
//      只在 /rankings/<窗>/;Topic 頁不是排行榜,不該再放一次時窗切換。
//   ③ 國旗列用 Unicode regional indicator 由 ISO 3166-1 alpha-2 組出來(見 lib/format.mjs),
//      不用圖檔、不用外部 CDN。
//   ④ 「歷史精華」資料恆為空,降到最低視覺權重、收在最後。
//   ⑤(本輪,用戶當面指正)頁首從「把各地叫法用 / 串成一行」改成**多國語言並陳**:
//      七個語系各自一區,各自的 title **與各自的 summary**(i18n.json 的 locales.<locale>.summary,
//      七語內容各寫各的,先前只讀了當前語系那一份,其餘六份根本沒上畫面)。
//      當前站台語系是主角(大字級 + 朱紅側規線),其餘六語降一級。
//      這**不是語系切換器**、也不是「本站有七種語言」的宣傳——七語系是七個獨立的站,
//      這裡呈現的是「同一個議題,七個市場各自怎麼說它」。
//   ⑥(本輪)分類/長青徽章列移出 header:header 內不得再有 <ul>。
//   ⑦(本輪)「🌎 全世界怎麼過」在頁首只留一個**連結**,實際區塊落在一屏之下,
//      預設收合、點了才展開並捲過去。收合用原生 <details>:HTML 出廠是 open,
//      **有 JS 才收起來**——沒有 JS 的讀者照樣讀得到各國怎麼過,不是永遠看不到。
//      捲動一律原生錨點 + CSS scroll-behavior(global.css,含 reduced-motion 保護),不寫 JS 動畫。
//
// 資料現實:facts.json 的 countries 為空的 Topic(如長青的 ask-the-world)不會有
// 「全世界怎麼過」與國旗列,頁首也就不放那個連結——空著比硬做假的好,底下三區塊照樣成立。
import BaseLayout from '../../layouts/BaseLayout.astro';
import DiscussionRoom from '../../components/DiscussionRoom.astro';
import { t, tOr } from '../../lib/i18n.mjs';
import { LOCALE, LOCALES, REACTION_SET } from '../../lib/config.mjs';
import { monthDay, dateTime, countryFlag } from '../../lib/format.mjs';
import { withBase } from '../../lib/paths.mjs';
import {
  listTopicIds, getTopicBundle, placesForTopic, eventsForTopic, countryName,
  customsText, topicRowBySlug, coverPath,
  relatedTopics, hotTopics,
} from '../../lib/data.mjs';

export function getStaticPaths() {
  // 模組頂層無法 await 匯入的環境:直接同步讀 data 目錄(build time)
  return listTopicIds()
    .map((topicId) => {
      const { facts } = getTopicBundle(topicId);
      return facts && facts.slug ? { params: { slug: facts.slug }, props: { topicId } } : null;
    })
    .filter(Boolean);
}

const ASK_THE_WORLD_SLUG = 'ask-the-world'; // §45 的跨國提問就是這個長青 Topic

const { topicId } = Astro.props;
const { facts, i18n, highlightItems } = getTopicBundle(topicId);
const loc = (i18n && i18n.locales && i18n.locales[LOCALE]) || {};
const title = loc.title || (facts && facts.canonical_name) || topicId;

// 頁首的「多國語言並陳」:當前站台語系排第一(主角),其餘六語照 LOCALES 的順序跟在後面。
// 每一區的 title 與 summary 都取**該語系自己那一份**——七語內容各寫各的,不是同一段翻七次。
// 語系標示用該語系的自稱(endonym),走 i18n 的 locale.<code> key,模板不寫死任何語言的字。
// 缺 title 的語系直接不列(資料還沒補上就不假造)。
const primaryLang = {
  code: LOCALE,
  label: t(`locale.${LOCALE}`),
  title,
  summary: loc.summary || '',
};
const otherLangs = LOCALES.filter((code) => code !== LOCALE)
  .map((code) => {
    const entry = (i18n && i18n.locales && i18n.locales[code]) || null;
    if (!entry || !entry.title) return null;
    return { code, label: t(`locale.${code}`), title: entry.title, summary: entry.summary || '' };
  })
  .filter(Boolean);

// cover 圖(1200×630,同時餵 og:image)。檔案不存在時 coverPath() 回 null,
// 整個 <figure> 就不渲染——不留破圖,版面照樣成立。
const coverRel = coverPath(facts && facts.slug);
const coverSrc = coverRel ? withBase(coverRel) : null;

// popularity_rank 是資料裡本來就有的順位,拿來決定「先讀哪一國」
const countries = ((facts && facts.countries) || [])
  .slice()
  .sort((a, b) => (a.popularity_rank || 99) - (b.popularity_rank || 99));
const hlList = highlightItems;
const places = placesForTopic(topicId);
const events = eventsForTopic(topicId);
const row = topicRowBySlug(facts && facts.slug) || {};
const category = (facts && facts.category) || row.category;
const isPerennial = (facts && facts.is_perennial) || row.is_perennial;
const isAskTheWorld = (facts && facts.slug) === ASK_THE_WORLD_SLUG;
const askHref = withBase(`topic/${ASK_THE_WORLD_SLUG}/`);

// 導覽列尾端的「直接跳進看板」在 Topic 頁上改列**相關議題**(facts.json 的 relations,
// 草案 §48 Topic Graph);沒有相關議題就退回熱門 Topic。當前這一頁自己不列(BaseLayout 會濾掉)。
const related = relatedTopics(topicId, 2);
const navTopics = related.length ? related : hotTopics(3);

// 📍 店家與 🎉 活動的 emoji reaction(2026-08-11 用戶:「店家和活動本來就有規劃 emoji,要補上」)。
// 行為沿用 src/lib/reactions.mjs——與貼文、留言同一份實作,同一顆 emoji 在站上任何地方
// 按下去的意義都一樣。契約 §4 的 target_type 已含 place / event,Worker 已支援,沒有新增端點。
//
// 初始計數:靜態 data/places/*.json、data/events/*.json 裡沒有 reaction 計數(權威在 D1),
//   所以 HTML 先渲染 0,再用 GET /v1/reactions/summary?target_type=place|event&ids=… 把真實
//   計數補上(2026-08-11 用戶指示;端點已上線,沒有新增或修改任何端點)。
//   拿不到就維持 0——不清空、不顯示錯誤。
// ⚠ 仍在的契約限制(不是 bug,不要「修」):summary 只回計數,**不回 mine**,
//   所以載入時一律是未按狀態,要按下去拿到 POST /v1/reactions 的回應才知道自己按過哪些。
const apiUrl = import.meta.env.PUBLIC_API_URL || '';
const cardReactionsConfig = {
  emojis: REACTION_SET, // 七顆全渲染(不含 👍)
  api: apiUrl, // 空字串 → reactions.mjs 退成唯讀 <span>,不做成看似可按的樣子
  i18n: { label: t('reaction.label'), failed: t('reaction.failed') },
};
// </script> 防拆:JSON 內任何 "<" 都轉義
const cardReactionsConfigJson = JSON.stringify(cardReactionsConfig).replace(/</g, '\\u003c');
---

<BaseLayout
  title={`${title} — aeiou.now`}
  description={loc.summary}
  navTopics={navTopics}
  currentTopicId={topicId}
  image={coverSrc}
>
  <article class="topic">
    <!-- 頁首 = 第一屏:cover 圖 + 七語言並陳 + 「🌎 全世界怎麼過」的連結。
         這裡刻意沒有 <ul>(徽章列已移到 header 之外),也沒有把各地叫法用 / 串成一行。 -->
    <header class="topic-head">
      <div class="head-main">
        {coverSrc && (
          <figure class="topic-cover">
            {/* alt="" :現在是純色塊佔位圖,沒有可描述的內容,硬編一句描述等於騙螢幕閱讀器。
                換上真圖時才會有值得寫的 alt。width/height 給瀏覽器先留位,載入時不跳版。 */}
            <img src={coverSrc} alt="" width="1200" height="630" decoding="async" />
          </figure>
        )}
        <div class="head-primary" lang={primaryLang.code}>
          <p class="lang-label">{primaryLang.label}</p>
          <h1>{primaryLang.title}</h1>
          {primaryLang.summary && <p class="topic-lede">{primaryLang.summary}</p>}
          {countries.length > 0 && (
            <a class="section-link" href="#world">
              <span class="section-emoji" aria-hidden="true">🌎</span>
              {t('topic.how_world_celebrates')} <span aria-hidden="true">↓</span>
            </a>
          )}
        </div>
      </div>

      <div class="head-langs">
        {otherLangs.map((lang) => (
          <div class="lang-block" lang={lang.code}>
            <p class="lang-label">{lang.label}</p>
            <p class="lang-title">{lang.title}</p>
            {lang.summary && <p class="lang-summary">{lang.summary}</p>}
          </div>
        ))}
      </div>
    </header>

    <!-- 分類/長青徽章:從 header 移出來(header 內不得再有 <ul>),但資訊本身沒有被砍掉 -->
    {(category || isPerennial) && (
      <ul class="badge-row topic-badges">
        {category && (
          <li><span class="badge badge--primary">{tOr(`category.${category}`, category)}</span></li>
        )}
        {isPerennial ? <li><span class="badge">{t('topic.perennial')}</span></li> : null}
      </ul>
    )}

    {countries.length > 0 && (
      <Fragment>
      <!-- 出廠就是 open:沒有 JS 的讀者要能讀到各國怎麼過。
           下面那支 is:inline 的小 script 才把它收起來(有 JS 才有「點了才展開」)。 -->
      <details class="zone-world" id="world" open>
        <summary class="world-summary">
          <h2><span class="section-emoji" aria-hidden="true">🌎</span>{t('topic.how_world_celebrates')}</h2>
        </summary>
        <ul class="country-list">
          {countries.map((c) => (
            <li class="country" id={`country-${c.country_code}`}>
              <div class="country-when">
                <span class="country-date">{monthDay(c.observed_date)}</span>
                {c.date_range_end && (
                  <span class="country-date-end">– {monthDay(c.date_range_end)}</span>
                )}
                <span class="country-when-label">{t('topic.local_date')}</span>
                {c.date_rule && <span class="country-rule">{c.date_rule}</span>}
              </div>
              <div class="country-body">
                <h3 class="country-name">
                  <span class="country-flag" aria-hidden="true">{countryFlag(c.country_code)}</span>
                  {countryName(c.country_code)}
                  <span class="local-name">{c.local_name}</span>
                </h3>
                {customsText(i18n, c.country_code) && (
                  <p class="country-customs">{customsText(i18n, c.country_code)}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </details>

      <!-- 只做兩件事,都不是捲動動畫:
           ① 有 JS 就把 <details> 收起來(無 JS 時 HTML 停在 open,內容照樣看得到)
           ② 點頁首那個連結、或點國旗列的某一國時,先展開再讓瀏覽器自己捲過去
           捲動本身完全交給原生錨點 + CSS scroll-behavior(reduced-motion 下不平滑)。
           放在這裡(元素之後、就地執行)是為了在畫到這一段之前就收合,不會先閃一下全展開。 -->
      <script is:inline>
        (function () {
          var world = document.getElementById('world');
          if (!world) return;
          world.open = false;
          document.addEventListener('click', function (ev) {
            var node = ev.target;
            if (!node || typeof node.closest !== 'function') return;
            if (node.closest('a[href="#world"], a[href^="#country-"]')) world.open = true;
          });
        })();
      </script>

      <nav class="flag-band" aria-label={t('topic.countries_label')}>
        {countries.map((c) => (
          <a class="flag-chip" href={`#country-${c.country_code}`}>
            <span class="flag-glyph" aria-hidden="true">{countryFlag(c.country_code)}</span>
            <span class="flag-name">{countryName(c.country_code)}</span>
          </a>
        ))}
      </nav>
      </Fragment>
    )}

    <!-- 三區塊:左上 📍 你附近、左下 🎉 相關活動、右 💬 大家正在聊(桌機佔滿整欄高)。
         DOM 順序就是窄螢幕的堆疊順序(你附近 → 相關活動 → 大家正在聊),不靠 order 調換,
         免得視覺順序與 tab 焦點順序對不上。 -->
    <script type="application/json" data-card-reactions-config set:html={cardReactionsConfigJson} />

    <div class="topic-zones">
      <div class="zone-col">
        <section class="zone-local" id="nearby">
          <div class="section-head">
            <h2><span class="section-emoji" aria-hidden="true">📍</span>{t('topic.near_you')}</h2>
          </div>
          {places.length === 0 && <p class="empty">{t('common.empty')}</p>}
          <ul class="card-list">
            {places.map((pl) => (
              <li class="mini-card">
                <h3>
                  <span class="mini-flag" aria-hidden="true">{countryFlag(pl.country_code)}</span>
                  {pl.name}
                </h3>
                {pl.descriptions && pl.descriptions[LOCALE] && <p>{pl.descriptions[LOCALE]}</p>}
                {pl.address && <p class="card-meta">{pl.address}</p>}
                {pl.map_url && (
                  <a class="card-link" href={pl.map_url} rel="noopener" target="_blank">
                    {t('topic.navigate')} <span aria-hidden="true">↗</span>
                  </a>
                )}
                <div
                  class="card-reactions"
                  data-card-reactions
                  data-target-type="place"
                  data-target-id={pl.place_id}
                ></div>
              </li>
            ))}
          </ul>
        </section>

        <section class="zone-local" id="events">
          <div class="section-head">
            <h2><span class="section-emoji" aria-hidden="true">🎉</span>{t('topic.events')}</h2>
          </div>
          {events.length === 0 && <p class="empty">{t('common.empty')}</p>}
          <ul class="card-list">
            {events.map((ev) => (
              <li class="mini-card">
                <h3>
                  <span class="mini-flag" aria-hidden="true">{countryFlag(ev.country_code)}</span>
                  {ev.name}
                </h3>
                {ev.descriptions && ev.descriptions[LOCALE] && <p>{ev.descriptions[LOCALE]}</p>}
                <p class="card-meta">
                  {ev.venue}
                  {ev.start_at && ` · ${dateTime(ev.start_at)}`}
                  {ev.end_at && ` – ${dateTime(ev.end_at)}`}
                </p>
                {ev.ticket_url && (
                  <a class="card-link" href={ev.ticket_url} rel="noopener" target="_blank">
                    {t('topic.tickets')} <span aria-hidden="true">↗</span>
                  </a>
                )}
                <div
                  class="card-reactions"
                  data-card-reactions
                  data-target-type="event"
                  data-target-id={ev.event_id}
                ></div>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <!-- 💬 討論串:這一頁的主體,不是附掛在文章底下的留言區 -->
      <section class="zone-talk" id="talking">
        <div class="section-head">
          <p class="eyebrow">{t('marker.now')}</p>
          <h2><span class="section-emoji" aria-hidden="true">💬</span>{t('topic.people_talking')}</h2>
        </div>
        <DiscussionRoom topicId={topicId} />
      </section>
    </div>

    <!-- 🌎 Ask the World(§45):M1 只做入口,跨國提問功能屬後續里程碑。
         ask-the-world 自己就是那個長青 Topic,所以在它自己的頁面上不再放入口。 -->
    {!isAskTheWorld && (
      <section class="zone-ask" id="ask">
        <a class="ask-link" href={askHref}>
          <span class="ask-emoji" aria-hidden="true">🌎</span>
          <span class="ask-body">
            <span class="ask-title">{t('topic.ask_the_world')}</span>
            <span class="ask-cta">{t('topic.ask_the_world_cta')}</span>
          </span>
          <span class="ask-arrow" aria-hidden="true">→</span>
        </a>
      </section>
    )}

    <!-- 歷史精華:不在 §44 的清單裡,資料恆為空,收在最後、最低視覺權重 -->
    <section class="zone-highlights" id="highlights">
      <h2 class="quiet-head">{t('topic.highlights')}</h2>
      {hlList.length === 0 && <p class="empty">{t('topic.highlights_empty')}</p>}
      {hlList.map((hl) => {
        const text =
          hl.original_locale === LOCALE
            ? hl.content
            : (hl.translations && hl.translations[LOCALE]) || hl.content;
        const translated = hl.original_locale !== LOCALE && hl.translations && hl.translations[LOCALE];
        return (
          <article class="highlight">
            <p class="highlight-content">{text}</p>
            <p class="highlight-meta">
              {countryName(hl.country_code)} · {hl.cycle_label}
            </p>
            {translated && (
              <details>
                <summary>{t('post.show_original')}</summary>
                <p class="highlight-original">{hl.content}</p>
              </details>
            )}
          </article>
        );
      })}
    </section>
  </article>
</BaseLayout>

<script>
  // 店家/活動的 emoji 列:沿用 src/lib/reactions.mjs(與貼文、留言同一份實作)。
  // 這裡只負責把每個 [data-card-reactions] 容器接上去,行為一律由 reactions.mjs 決定。
  import { createReactions } from '../../lib/reactions.mjs';

  const cfgNode = document.querySelector('[data-card-reactions-config]');
  if (cfgNode) {
    let cfg = null;
    try {
      cfg = JSON.parse(cfgNode.textContent);
    } catch {
      cfg = null; // 設定壞掉就整段不掛,寧可沒有 emoji 也不要半殘的控制項
    }
    if (cfg) {
      // counts 為 null 時 reactions.mjs 一律畫 0(靜態資料沒有 reaction 計數,權威在 D1)。
      // summary 回來之後用同一支重畫一次,計數才是真值——reactions.mjs 只讀不改。
      const mount = (box, counts) => {
        const row = createReactions({
          targetType: box.dataset.targetType, // 'place' | 'event'(契約 §4 已含這兩種)
          targetId: box.dataset.targetId,
          emojis: cfg.emojis,
          counts: counts || undefined,
          api: cfg.api,
          i18n: cfg.i18n,
          classes: {
            btn: 'card-reaction',
            emoji: 'card-reaction-emoji',
            count: 'card-reaction-count',
            status: 'card-reaction-status',
            mine: 'is-mine',
            error: 'is-error',
          },
        });
        box.textContent = '';
        row.nodes.forEach((node) => box.appendChild(node));
      };

      const boxes = Array.prototype.filter.call(
        document.querySelectorAll('[data-card-reactions]'),
        (box) => !!box.dataset.targetId
      );
      boxes.forEach((box) => mount(box, null));

      // 真實計數:一種 target_type 一支請求,一次最多 100 個 id(契約 §4 的 summary)。
      // 失敗就靜靜留著 0——不清空、不顯示錯誤內容。
      if (cfg.api) {
        ['place', 'event'].forEach((type) => {
          const mine = boxes.filter((box) => box.dataset.targetType === type);
          const ids = mine.map((box) => box.dataset.targetId).slice(0, 100);
          if (ids.length === 0) return;
          fetch(
            cfg.api +
              '/v1/reactions/summary?target_type=' +
              encodeURIComponent(type) +
              '&ids=' +
              ids.map(encodeURIComponent).join(','),
            { credentials: 'include' } // anon_id 是跨站 cookie
          )
            .then((res) => (res.ok ? res.json() : null))
            .then((data) => {
              const items = (data && data.items) || null;
              if (!items) return;
              mine.forEach((box) => {
                const hit = items[box.dataset.targetId];
                if (hit && hit.reactions) mount(box, hit.reactions);
              });
            })
            .catch(() => {});
        });
      }
    }
  }
</script>

<style>
  .topic > section {
    margin-block-end: clamp(2.5rem, 6vw, 4rem);
    scroll-margin-block-start: 1rem;
  }
  .empty {
    color: var(--color-ink-muted);
