---
// Topic 頁 = 一個看板。版面(2026-08-11 用戶拍板,第 11 輪逐字修正):
//
//   ┌───────────────────────────────────────────────┐  ← 第一屏 = 一個視窗高
//   │ header > .head-main(整幅寬,約佔第一屏 40%)     │
//   ├───────────────────────┬───────────────────────┤
//   │ 左 50%                 │ 右 50%                │
//   │  ├ 📍 #nearby(上半)    │  💬 #talking          │
//   │  └ 🎉 #events(下半)    │  (整欄高)              │
//   └───────────────────────┴───────────────────────┘
//   之後依序:🌎 #ask 入口 → 歷史精華 #highlights → 🌎 #world(整頁最後)
//
// 2026-08-11 的修正史:
//   ① 資訊架構:討論回到主位。更早的版本把「全世界怎麼過」做成招牌大圖、討論縮成小面板,
//      那是雜誌文章網站的排法;這是主題頁論壇,討論串就是內容本身。
//   ② 版面:🔥 熱門趨勢(七個時窗切換)整區移除。時窗切換屬**排行榜層**,
//      只在 /rankings/<窗>/;Topic 頁不是排行榜,不該再放一次時窗切換。
//   ③ 國旗列用 Unicode regional indicator 由 ISO 3166-1 alpha-2 組出來(見 lib/format.mjs),
//      不用圖檔、不用外部 CDN。
//   ④ 「歷史精華」資料恆為空,降到最低視覺權重、收在最後。
//   ⑤ 頁首從「把各地叫法用 / 串成一行」改成**多國語言並陳**:七語各自的 summary
//      (i18n.json 的 locales.<locale>.summary,七語內容各寫各的)都要上畫面。
//      **第 11 輪修正:不另開 .head-langs 區塊**——七段直接疊在 .head-main > .head-primary 裡,
//      每段都是一個 <p class="topic-lede" lang="…">,當前站台語系那段為主(較大、較高對比),
//      其餘六語依序在下。語系標示留著(i18n 的 locale.<code>),但只是段內的一個 <span>。
//      這**不是語系切換器**、也不是「本站有七種語言」的宣傳——七語系是七個獨立的站,
//      這裡呈現的是「同一個議題,七個市場各自怎麼說它」。
//   ⑥(第 11 輪)分類/長青徽章列**整列刪除**:header 內不得有 <ul>,article 直屬也不得有 <ul>。
//   ⑦「🌎 全世界怎麼過」在頁首只留一個**連結**,實際區塊在**整頁最下面**(第 11 輪),
//      國家導覽直接放在 #world > summary > h2 右側,不另開 article 直屬 nav 區塊。
//      預設收合、點了才展開並捲過去。收合用原生 <details>:HTML 出廠是 open,
//      **有 JS 才收起來**——沒有 JS 的讀者照樣讀得到各國怎麼過,不是永遠看不到。
//      捲動一律原生錨點 + CSS scroll-behavior(global.css,含 reduced-motion 保護),不寫 JS 動畫。
//
// 資料現實:facts.json 的 observances 為空的 Topic(如長青的 ask-the-world)不會有
// 「全世界怎麼過」與國旗列,頁首也就不放那個連結——空著比硬做假的好,底下三區塊照樣成立。
import BaseLayout from '../../layouts/BaseLayout.astro';
import DiscussionRoom from '../../components/DiscussionRoom.astro';
import { t } from '../../lib/i18n.mjs';
import { LOCALE, MARKET_CITY, MARKET_COUNTRY, REACTION_SET } from '../../lib/config.mjs';
import { calendarDate, dateTime, countryFlag } from '../../lib/format.mjs';
import { withBase } from '../../lib/paths.mjs';
import { compactDescription, fillTemplate, seoCopy, sourceLabel, SITE_NAME } from '../../lib/seo.mjs';
import {
  listTopicIds, getTopicBundle, placesForTopic, eventsForTopic, countryName,
  observancesForFacts, customsText, regionalNotesForFacts, regionalNoteText,
  coverPath, relatedTopics, readJson, getTopicsIndex,
} from '../../lib/data.mjs';

export function getStaticPaths() {
  // 模組頂層無法 await 匯入的環境:直接同步讀 data 目錄(build time)
  return listTopicIds()
    .map((topicId) => {
      const { facts } = getTopicBundle(topicId);
      return facts && facts.slug ? { params: { slug: facts.slug }, props: { topicId } } : null;
    })
    .filter(Boolean)
    .concat(
      ((readJson('topic-merges.json', {})?.merges) || [])
        .map((merge) => {
          const target = getTopicsIndex().find((topic) => topic.slug === merge.to);
          return target
            ? { params: { slug: merge.from }, props: { topicId: target.topic_id, aliasFor: merge.to } }
            : null;
        })
        .filter(Boolean),
    );
}

const { topicId, aliasFor = null } = Astro.props;
const { facts, i18n } = getTopicBundle(topicId);
const loc = (i18n && i18n.locales && i18n.locales[LOCALE]) || {};
const title = loc.title || (facts && facts.canonical_name) || topicId;

// cover 圖(1200×675,Google Discover 建議的 16:9 大圖,同時餵 og:image)。檔案不存在時 coverPath() 回 null,
// 整個 <figure> 就不渲染——不留破圖,版面照樣成立。
const coverRel = coverPath(facts && facts.slug);
const coverSrc = coverRel ? withBase(coverRel) : null;

// next_occurrence 是匯出層依地方時區產出的下一次實際日期；頁面不解析 date_rule。
// 日期相同時才用 popularity_rank，沒有 occurrence 的舊資料排在最後，且不補猜日期。
const observances = observancesForFacts(facts)
  .slice()
  .sort((a, b) => {
    const aDistance = a.next_occurrence?.distance_days;
    const bDistance = b.next_occurrence?.distance_days;
    if (aDistance == null && bDistance == null) return (a.popularity_rank || 99) - (b.popularity_rank || 99);
    if (aDistance == null) return 1;
    if (bDistance == null) return -1;
    return aDistance - bDistance
      || (a.next_occurrence?.starts_on || '').localeCompare(b.next_occurrence?.starts_on || '')
      || (a.popularity_rank || 99) - (b.popularity_rank || 99)
      || String(a.observance_id).localeCompare(String(b.observance_id));
  });
// 問答以「每個國家一筆」呈現，避免同一國有多個 observance 時只顯示前幾筆，
// 也讓新增國家資料會自然進入 FAQ 與頁面可見內容。
const countries = [...new Set(observances.map((o) => o.country_code).filter(Boolean))]
  .map((countryCode) => observances.find((o) => o.country_code === countryCode && o.next_occurrence)
    || observances.find((o) => o.country_code === countryCode))
  .filter(Boolean);
const regionalNotes = regionalNotesForFacts(facts);
const regionalOnlyNotes = regionalNotes
  .filter((note) => !countries.some((country) => country.country_code === note.country_code));
const worldCountries = [
  ...countries.map((country) => ({ ...country, kind: 'observance' })),
  ...regionalOnlyNotes.map((note) => ({ ...note, kind: 'regional' })),
];
// 錨點要可讀(2026-08-20):原本直接用 observance_id,長成
// #observance-obs_top_01KZXQ6BRP69FEV2DWA2VSH7QD_ID_ramadan —— 對讀者不可分享,
// 對 Google 也無法當成有意義的段落錨。改用「國碼-observance_key」,
// 那組合本來就是同一個 Topic 內的唯一鍵。缺 observance_key 的舊資料才退回 id。
const observanceAnchor = (observance) => {
  const key = observance.observance_key
    ? `${observance.country_code}-${observance.observance_key}`
    : observance.observance_id;
  return `observance-${String(key).toLowerCase().replace(/[^a-z0-9-]+/g, '-').replace(/^-+|-+$/g, '')}`;
};
const regionalAnchor = (note) => `regional-${note.country_code.toLowerCase()}`;

// 🌎 底下每一國的標題改成讀者實際會打的問句(2026-08-21 用戶核准動版面)。
// 原本是國名(「🇹🇼 台灣」)——那對 Google 宣告的只有「這一段提到台灣」,
// 但站上最有價值的內容(七國制度比較 + 官方來源)回答的其實是
// 「台灣怎麼過這個節日」「巴西有沒有這個節日」。GSC 實測有人真的在打
// `children's day china`、`dia dos namorados japão`、`hari ibu di jepang`、
// `is teachers day celebrated all over the world`,而我們排 36–71 名。
// 句型全部來自 i18n(語序各語系自己決定,hi/id/pt-BR 與中文語序不同),
// 國名與 Topic 名來自資料 —— 這裡不新增任何文案。
// absence(查證過「這裡沒有這個節日」)用「有沒有」問句,其餘用「怎麼過」。
// 問句的主詞一律是**本站語系的 Topic 名**,不是 observance 的 local_name。
// 試過拿 local_name 當主詞來分辨同一國的兩筆(日本的バレンタインデー與ホワイトデー),
// 結果 pt-BR 站印出「Japão: como vivenciam バレンタインデー?」—— 讀者看不懂的字進了標題。
// 同一國有兩筆時靠 h3 尾巴的 .local-name 區分(那裡本來就該是當地叫法),問句照樣成立。
// Ask the World(草案 §45)的提問對象名單 = 這個 Topic 實際涵蓋的國家。
// 國名用本站語系的說法、國旗由 ISO 兩碼組出來(同 🌎 的國旗列,不用圖檔、不打外部 CDN)。
// 名單空的 Topic(長青、還沒建國家資料)發文框就不長選單,行為與過去一樣。
const askCountries = worldCountries.map((country) => ({
  code: country.country_code,
  flag: countryFlag(country.country_code),
  name: countryName(country.country_code),
}));

const countryQuestion = (countryCode, isAbsence = false) => fillTemplate(
  t(isAbsence ? 'topic.q_country_has' : 'topic.q_how_country'),
  { country: countryName(countryCode), topic: title },
);
// 同一國在同一個 Topic 底下有兩筆(日本的バレンタインデー與ホワイトデー、印尼的
// Ramadan 與 Idulfitri)時,光靠問句兩個 h3 會一字不差 —— check-rendered-depth 的 D3
// (同一頁不得有重複長段落)會擋,而它擋得對:讀者也分不出那兩段在講什麼。
// 分辨用當地叫法接在問句後面,**不是**拿它當問句主詞:試過
//「Japão: como vivenciam バレンタインデー?」,那是把讀者看不懂的字放進主詞位置。
// 併進同一個文字節點(中間不夾標籤),D3 才看得出這兩行不一樣。
const observanceCountBy = observances.reduce((acc, observance) => {
  acc[observance.country_code] = (acc[observance.country_code] || 0) + 1;
  return acc;
}, {});
const needsLocalName = (observance) => observanceCountBy[observance.country_code] > 1
  && Boolean(observance.local_name);
const observanceHeading = (observance) => (needsLocalName(observance)
  ? `${countryQuestion(observance.country_code)} · ${observance.local_name}`
  : countryQuestion(observance.country_code));
// 「你附近／相關活動」是本語系站代表城市的在地資料，不是七市場資料總覽。
// 📍 只收可被拜訪的常設地點；🎉 只收有日期與來源的活動。七市場文化比較在 🌎。
const marketCity = MARKET_CITY[LOCALE] || null;
const places = placesForTopic(topicId, marketCity);
const events = eventsForTopic(topicId, marketCity);
const copy = seoCopy();
const sourceUrls = [...new Set([
  ...(facts?.source_urls || []),
  ...observances.flatMap((observance) => observance.source_urls || []),
  ...observances.flatMap((observance) => observance.next_occurrence?.source_urls || []),
  ...regionalNotes.flatMap((note) => note.source_urls || []),
])].filter((url) => /^https?:\/\//.test(url));
const whatAnswer = loc.summary || facts?.commonality || copy.noDate;
// 七語系是七個獨立的站,每個站服務一個代表市場。本站市場的那一國要排最前面 ——
// 2026-08-20 實測:id 站的 affection-and-reciprocity 摘要開頭是「印度、中國」,
// 印尼自己沒進前兩筆;而落在那一頁的查詢正是 `kapan hari valentine 2027`。
// 讀者問的是自己國家,搜尋結果卻先給他別人的日期。排序不是文案,是資訊架構。
const HOME_COUNTRY = MARKET_COUNTRY[LOCALE] || null;
const homeFirst = (list) => [
  ...list.filter((x) => x.country_code === HOME_COUNTRY),
  ...list.filter((x) => x.country_code !== HOME_COUNTRY),
];
const metaCoverage = homeFirst(worldCountries)
  .map((country) => {
    const parts = [countryName(country.country_code)];
    if (country.kind === 'observance' && country.local_name) parts.push(country.local_name);
    return parts.join(' · ');
  })
  .join(copy.listSep);
const dateAnswer = homeFirst(countries)
  .filter((observance) => observance.next_occurrence)
  .map((observance) => {
    const next = observance.next_occurrence;
    const end = next.ends_on ? `–${calendarDate(next.ends_on)}` : '';
    return `${countryName(observance.country_code)} · ${calendarDate(next.starts_on)}${end}`;
  });

// 標題與 meta 宣告的是「跨國制度比較」,不是「這個節日幾號」(2026-08-21 用戶拍板改版)。
//
// 前一版(2026-08-19)把日期擺第一,理由是 GSC 上排進前 10 的查詢都在問日期。
// 那個觀察沒錯,結論錯了 —— 2026-08-21 重查同一份資料,把 63 個查詢按意圖分兩類:
//   日期/名稱型  44 個查詢、85 曝光、平均名次 32.7、**點擊 0**
//   跨國/制度型  19 個查詢、25 曝光、平均名次 67.6、**點擊 0**
// 日期型那批在名次 4–9 累積 41 次曝光仍然 0 點擊(若真實 CTR 有 8%,出現 0 點擊的機率約 3%)
// —— 因為「X 年 Y 節是幾號」是 Google 答案框的標準品,排第一也不會有人點進來。
// 反過來,已經有人在問 `is teachers day celebrated all over the world`(名次 71)、
// `dia dos namorados japão`(45)、`hari ibu di jepang`(36)、`children's day china`(56):
// 這些正是站上唯一有優勢的內容(七國制度比較 + 官方來源),而我們排在 60–90 名,
// 因為整頁對 Google 宣告的主題是日期。**資產與宣告錯配,不是排名不夠努力。**
//
// 所以:title 保留年份(免費,而且讀者本來就那樣打字),但後綴改成「N 國怎麼過、哪裡放假」;
// description 改成 summary 先行 —— loc.summary 本來就在講制度差異
// (例:「開齋節在四個地方有四種身分…」),它才是點擊理由,日期壓到句末。
// 這裡不新增任何文案 —— 年份與國家數取自資料,其餘字串全部來自 SEO_COPY。
const nextStart = countries
  .map((observance) => observance.next_occurrence?.starts_on)
  .filter(Boolean)
  .sort()[0] || null;
const titleYear = nextStart ? nextStart.slice(0, 4) : null;
// 沒有任何國家資料的 Topic(長青的 ask-the-world 等)沒有「N 國」可講,退回原本的後綴。
const titleSuffix = worldCountries.length > 0
  ? fillTemplate(copy.compareSuffix, { count: worldCountries.length })
  : copy.metaSuffix;
const pageTitle = titleYear
  ? `${title} ${titleYear}${copy.titleSep}${titleSuffix}${copy.titleSep}${SITE_NAME}`
  : `${title}${copy.titleSep}${titleSuffix}${copy.titleSep}${SITE_NAME}`;

// description 的第一句必須是**本市場那一國**(check-local-scope.mjs 的 assertHomeCountryFirst,
// 立法緣由 2026-08-20:id 站的摘要開頭是「印度、中國」,印尼自己沒進前兩筆)。
// 這條規則跟「先講制度、不要先講日期」不衝突,反而合流 —— 讀者要的正是**他自己國家**
// 的制度答案(「台灣的移工到底放不放假」),那既是首句、也是最強的點擊理由。
// 本市場那一格沒有敘述時才退回日期開頭(舊行為),不讓守門條件落空。
const homeCountryEntry = worldCountries.find((country) => country.country_code === HOME_COUNTRY) || null;
const homeCountryAnswer = homeCountryEntry
  ? (homeCountryEntry.kind === 'observance'
    ? customsText(i18n, homeCountryEntry)
    : regionalNoteText(i18n, homeCountryEntry))
  : null;
const dateSentence = dateAnswer.length > 0
  ? `${dateAnswer.slice(0, 2).join(copy.listSep)}${copy.endMark}`
  : null;
// 敘述本來就以國名開頭時不再加一次前綴 —— 否則會印出「台灣：台灣不把開齋節列為…」。
const homeCountryLabel = homeCountryEntry ? countryName(HOME_COUNTRY) : '';
const homeLead = homeCountryEntry && homeCountryAnswer
  ? (homeCountryAnswer.startsWith(homeCountryLabel)
    ? homeCountryAnswer
    : `${homeCountryLabel}${copy.colon}${homeCountryAnswer}`)
  : dateSentence;
const metaDescription = compactDescription([
  homeLead,
  whatAnswer,
  metaCoverage ? `${copy.coveragePrefix} ${metaCoverage}${copy.endMark}` : null,
  homeLead === dateSentence ? null : dateSentence,
  sourceUrls.length > 0 ? copy.sourceMeta : null,
].filter(Boolean).join(' '));
const whereAnswer = worldCountries.length > 0
  ? homeFirst(worldCountries).map((country) => {
    const parts = [countryName(country.country_code)];
    if (country.kind === 'observance') {
      if (country.local_name) parts.push(country.local_name);
      if (country.date_rule) parts.push(country.date_rule);
    }
    return parts.join(' · ');
  }).join(copy.itemSep)
  : copy.noDate;
const differenceAnswer = [
  ...countries
  .map((country) => {
    const text = customsText(i18n, country);
    return text ? `${countryName(country.country_code)}${copy.colon}${text}` : null;
  })
  .filter(Boolean),
  ...regionalOnlyNotes
    .map((note) => {
      const text = regionalNoteText(i18n, note);
      return text ? `${countryName(note.country_code)}${copy.colon}${text}` : null;
    })
    .filter(Boolean),
].join(' ') || (worldCountries.length === 0 ? whatAnswer : copy.noDate);
const related = relatedTopics(topicId, 4);
const eventSchema = events.map((event) => ({
  '@type': 'Event',
  name: event.name,
  startDate: event.start_at ? new Date(event.start_at * 1000).toISOString() : undefined,
  endDate: event.end_at ? new Date(event.end_at * 1000).toISOString() : undefined,
  location: { '@type': 'Place', name: event.venue },
  url: event.ticket_url || event.source_url || undefined,
  description: event.descriptions?.[LOCALE] || undefined,
})).map((event) => Object.fromEntries(Object.entries(event).filter(([, value]) => value != null)));
const topicSchema = [
  {
    '@type': 'DefinedTerm',
    name: title,
    description: whatAnswer,
    ...(Array.isArray(loc.keywords) && loc.keywords.length > 1
      ? { alternateName: loc.keywords.filter((keyword) => keyword && keyword !== title).slice(0, 8) }
      : {}),
    inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'aeiou.now Topics' },
  },
  {
    // FAQ 的每一題都必須在頁面上看得到(Google 的 FAQPage 規範),所以逐國那幾題用的是
    // 🌎 底下**實際印出來的那個 h3 問句**與它下面那段文字,不是另外編一組問答。
    // 逐國問答放在四個通題後面:通題講整個 Topic,逐國題才是這一頁真正獨有的內容
    // (2026-08-21,與 h3 問句化同一輪)。
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: copy.what, acceptedAnswer: { '@type': 'Answer', text: whatAnswer } },
      { '@type': 'Question', name: copy.when, acceptedAnswer: { '@type': 'Answer', text: dateAnswer.length ? dateAnswer.join(copy.itemSep) : copy.noDate } },
      { '@type': 'Question', name: copy.where, acceptedAnswer: { '@type': 'Answer', text: whereAnswer } },
      { '@type': 'Question', name: copy.differences, acceptedAnswer: { '@type': 'Answer', text: differenceAnswer } },
      ...observances
        .map((observance) => ({ q: observanceHeading(observance), a: customsText(i18n, observance) }))
        .filter((entry) => entry.a)
        .map((entry) => ({ '@type': 'Question', name: entry.q, acceptedAnswer: { '@type': 'Answer', text: entry.a } })),
      ...regionalOnlyNotes
        .map((note) => ({ q: countryQuestion(note.country_code, note.kind === 'absence'), a: regionalNoteText(i18n, note) }))
        .filter((entry) => entry.a)
        .map((entry) => ({ '@type': 'Question', name: entry.q, acceptedAnswer: { '@type': 'Answer', text: entry.a } })),
    ],
  },
  ...eventSchema,
];

// 📍 店家與 🎉 活動的 emoji reaction(2026-08-11 用戶:「店家和活動本來就有規劃 emoji,要補上」)。
// 行為沿用 src/lib/reactions.mjs——與貼文、留言同一份實作,同一顆 emoji 在站上任何地方
// 按下去的意義都一樣。契約 §4 的 target_type 已含 place / event,Worker 已支援,沒有新增端點。
//
// 初始計數:靜態 data/places/*.json、data/events/*.json 裡沒有 reaction 計數(權威在 D1),
//   所以 HTML 先渲染 0,再用 GET /v1/reactions/summary?target_type=place|event&ids=… 把真實
//   計數補上(2026-08-11 用戶指示;端點已上線,沒有新增或修改任何端點)。
//   拿不到就維持 0——不清空、不顯示錯誤。
// ⚠ 仍在的契約限制(不是 bug,不要「修」):summary 只回計數,**不回 mine**,
//   所以載入時一律是未按狀態,要按下去拿到 POST /v1/reactions 的回應才知道自己按過哪些。
const apiUrl = import.meta.env.PUBLIC_API_URL || '';
const cardReactionsConfig = {
  emojis: REACTION_SET, // 七顆全渲染(不含 👍)
  api: apiUrl, // 空字串 → reactions.mjs 退成唯讀 <span>,不做成看似可按的樣子
  i18n: { label: t('reaction.label'), failed: t('reaction.failed') },
};
// </script> 防拆:JSON 內任何 "<" 都轉義
const cardReactionsConfigJson = JSON.stringify(cardReactionsConfig).replace(/</g, '\\u003c');
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  image={coverSrc}
  imageAlt={title}
  pageType="WebPage"
  canonicalPath={aliasFor ? withBase(`topic/${aliasFor}/`) : null}
  indexable={!aliasFor}
  redirectTo={aliasFor ? withBase(`topic/${aliasFor}/`) : null}
  structuredData={topicSchema}
>
  <article class="topic" data-topic-slug={facts?.slug}>
    <!-- 頁首 = 第一屏的上半:cover 圖 + 七語系的 lede 並陳 + 「🌎 全世界怎麼過」的連結。
         header 內沒有 <ul>,也沒有另開的語系方格區塊——七段 lede 就疊在 .head-primary 裡。 -->
    <header class="topic-head">
      <div class="head-main">
        {coverSrc && (
          <figure class="topic-cover">
            <img src={coverSrc} alt={title} width="1200" height="675" loading="eager" fetchpriority="high" decoding="async" />
          </figure>
        )}
        <div class="head-primary">
          {/* 標題與「🌎 全世界怎麼過 ↓」排同一行(2026-08-11 用戶指示) */}
          <div class="head-title-row">
            <h1>{title}</h1>
            {worldCountries.length > 0 && (
              <a class="section-link" href="#world">
                <span class="section-emoji" aria-hidden="true">🌎</span>
                {t('topic.how_world_celebrates')} <span aria-hidden="true">↓</span>
              </a>
            )}
          </div>
          {/* 只有本站語系的說明。「不同語系顯示相同 Topic 說明」指的是**七個站各自顯示自己的語言**
              (ja 站看到日文、pt-BR 站看到葡文),不是把七語堆在同一頁,也不標示這是哪一國語言。 */}
          {loc.summary && <p class="topic-lede">{loc.summary}</p>}
        </div>
      </div>
    </header>

    <section class="topic-answers" id="answers">
      <div class="section-head">
        <h2>{copy.answers}</h2>
      </div>
      {/* 只留**沒有在別處印過**的兩張卡(2026-08-20 用戶核准動版面)。
          原本四張卡裡有兩張是整段複印:
            ・「這個主題是什麼?」= loc.summary,與頁首的 .topic-lede 一字不差
            ・「各地有什麼不同?」= 各國 customsText 串接,而 🌎 #world 底下逐國又印一次
          那讓每個 Topic 頁的可見文字約有三分之一是重複的——頁面看起來有量,唯一內容只有三分之一
          (2026-08-19 GA/GSC 診斷的實測結果)。
          四個問答仍**完整保留在下方的 FAQPage JSON-LD**:它們的答案文字都在這一頁上看得到
          (什麼→頁首 lede;不同→🌎 各國段落),符合結構化資料必須對應可見內容的要求。
          機械層防線=site/scripts/check-rendered-depth.mjs 的 D3(同頁長段落重複上限 1)。 */}
      <dl class="answer-grid">
        <div class="answer-card">
          <dt>{copy.when}</dt>
          <dd>{dateAnswer.length ? dateAnswer.join(copy.itemSep) : copy.noDate}</dd>
        </div>
        <div class="answer-card">
          <dt>{copy.where}</dt>
          <dd>{whereAnswer}</dd>
        </div>
      </dl>
    </section>

    <!-- 三區塊:左上 📍 你附近、左下 🎉 相關活動、右 💬 大家正在聊(桌機佔滿整欄高)。
         DOM 順序就是窄螢幕的堆疊順序(你附近 → 相關活動 → 大家正在聊),不靠 order 調換,
         免得視覺順序與 tab 焦點順序對不上。 -->
    <script type="application/json" data-card-reactions-config set:html={cardReactionsConfigJson} />

    <div class="topic-zones">
      <div class="zone-col">
        <section class="zone-local" id="nearby">
          <div class="section-head">
            <h2><span class="section-emoji" aria-hidden="true">📍</span>{t('topic.near_you')}</h2>
          </div>
          {places.length === 0 && <p class="empty">{t('common.empty')}</p>}
          <ul class="card-list">
            {places.map((pl) => (
              <li class="mini-card">
                <h3>
                  <span class="mini-flag" aria-hidden="true">{countryFlag(pl.country_code)}</span>
                  {pl.name}
                </h3>
                {pl.descriptions && pl.descriptions[LOCALE] && <p>{pl.descriptions[LOCALE]}</p>}
                {pl.address && <p class="card-meta">{pl.address}</p>}
                {pl.map_url && (
                  <a class="card-link" data-local-action="map" data-local-type="place" data-local-id={pl.place_id} href={pl.map_url} rel="noopener" target="_blank">
                    {t('topic.navigate')} <span aria-hidden="true">↗</span>
                  </a>
                )}
                <div
                  class="card-reactions"
                  data-card-reactions
                  data-target-type="place"
                  data-target-id={pl.place_id}
                ></div>
              </li>
            ))}
          </ul>
        </section>

        <section class="zone-local" id="events">
          <div class="section-head">
            <h2><span class="section-emoji" aria-hidden="true">🎉</span>{t('topic.events')}</h2>
          </div>
          {events.length === 0 && <p class="empty">{t('common.empty')}</p>}
          <ul class="card-list">
            {events.map((ev) => (
              <li class="mini-card">
                <h3>
                  <span class="mini-flag" aria-hidden="true">{countryFlag(ev.country_code)}</span>
                  {ev.name}
                </h3>
                {ev.descriptions && ev.descriptions[LOCALE] && <p>{ev.descriptions[LOCALE]}</p>}
                <p class="card-meta">
                  {ev.venue}
                  {ev.start_at && ` · ${dateTime(ev.start_at)}`}
                  {ev.end_at && ` – ${dateTime(ev.end_at)}`}
                </p>
                {ev.ticket_url && (
                  <a class="card-link" data-local-action="ticket" data-local-type="event" data-local-id={ev.event_id} href={ev.ticket_url} rel="noopener" target="_blank">
                    {t('topic.tickets')} <span aria-hidden="true">↗</span>
                  </a>
                )}
                <div
                  class="card-reactions"
                  data-card-reactions
                  data-target-type="event"
                  data-target-id={ev.event_id}
                ></div>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <!-- 💬 討論串:這一頁的主體,不是附掛在文章底下的留言區 -->
      <section class="zone-talk" id="talking">
        <div class="section-head">
          <p class="eyebrow">{t('marker.now')}</p>
          <h2><span class="section-emoji" aria-hidden="true">💬</span>{t('topic.people_talking')}</h2>
        </div>
        <DiscussionRoom topicId={topicId} askCountries={askCountries} />
      </section>
    </div>

    <!-- 🌎 Ask the World(§45):M1 只做入口,跨國提問功能屬後續里程碑。
         ask-the-world 自己就是那個長青 Topic,所以在它自己的頁面上不再放入口。 -->


    <!-- 🌎 全世界怎麼過:整頁最後一段(第 11 輪用戶指示)。頁首那個「🌎 … ↓」連結照舊指過來,
         現在等於捲到頁尾。國家導覽是 #world summary 的一部分,緊貼在標題右側。 -->
    {worldCountries.length > 0 && (
      <Fragment>
      <!-- 出廠就是 open:沒有 JS 的讀者要能讀到各國怎麼過。
           下面那支 is:inline 的小 script 才把它收起來(有 JS 才有「點了才展開」)。 -->
      <details class="zone-world" id="world" open>
        <summary class="world-summary">
          <h2><span class="section-emoji" aria-hidden="true">🌎</span>{t('topic.how_world_celebrates')}</h2>
          <nav class="world-countries" aria-label={t('topic.countries_label')}>
            {worldCountries.map((c) => (
              <a class="flag-chip" href={`#${c.kind === 'regional' ? regionalAnchor(c) : observanceAnchor(c)}`}>
                <span class="flag-glyph" aria-hidden="true">{countryFlag(c.country_code)}</span>
                <span class="flag-name">{countryName(c.country_code)}</span>
              </a>
            ))}
          </nav>
        </summary>
        <ul class="country-list">
          {observances.map((c) => (
            <li class="country" id={observanceAnchor(c)}>
              <div class="country-when">
                {c.next_occurrence ? (
                  <>
                    <span class="country-date">{calendarDate(c.next_occurrence.starts_on)}</span>
                    {c.next_occurrence.ends_on && (
                      <span class="country-date-end">– {calendarDate(c.next_occurrence.ends_on)}</span>
                    )}
                  </>
                ) : (
                  <span class="country-date">{t('topic.date_unavailable')}</span>
                )}
                <span class="country-when-label">{t('topic.local_date')}</span>
                {c.next_occurrence?.date_status === 'estimated' && (
                  <span class="country-date-status">{t('topic.date_estimated')}</span>
                )}
                {c.next_occurrence?.date_status === 'local-variant' && (
                  <span class="country-date-status">{t('topic.date_local_variant')}</span>
                )}
                {c.date_rule && <span class="country-rule">{c.date_rule}</span>}
              </div>
              <div class="country-body">
                <h3 class="country-name">
                  <span class="country-flag" aria-hidden="true">{countryFlag(c.country_code)}</span>
                  {observanceHeading(c)}
                  {!needsLocalName(c) && <span class="local-name">{c.local_name}</span>}
                </h3>
                {customsText(i18n, c) && (
                  <p class="country-customs">{customsText(i18n, c)}</p>
                )}
                {(c.source_urls || []).length > 0 && (
                  <p class="country-sources">
                    {(c.source_urls || []).slice(0, 2).map((url) => (
                      <a class="source-link" data-source-link data-source-url={url} href={url} rel="noopener noreferrer" target="_blank" aria-label={`${copy.sourceLink}: ${sourceLabel(url)}`} title={url}>{sourceLabel(url)} ↗</a>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))}
          {regionalOnlyNotes.map((note) => (
            <li class="country" id={regionalAnchor(note)}>
              <div class="country-when">
                {/* 「這裡沒有這個節日」與「日期待確認」是兩件事。前者是查證過的事實,
                    後者是還沒查到 —— 用同一個標籤等於把確定的事講成待辦
                    (同 2026-08-20 closed/loading 的教訓:狀態名稱要說事實)。 */}
                <span class="country-date">{note.kind === 'absence' ? t('topic.no_local_observance') : t('topic.date_unavailable')}</span>
                <span class="country-when-label">{t('topic.local_date')}</span>
                <span class="country-rule">{note.kind === 'absence' ? t('topic.no_local_observance_rule') : t('topic.perennial')}</span>
              </div>
              <div class="country-body">
                <h3 class="country-name">
                  <span class="country-flag" aria-hidden="true">{countryFlag(note.country_code)}</span>
                  {countryQuestion(note.country_code, note.kind === 'absence')}
                </h3>
                {regionalNoteText(i18n, note) && (
                  <p class="country-customs">{regionalNoteText(i18n, note)}</p>
                )}
                {(note.source_urls || []).length > 0 && (
                  <p class="country-sources">
                    {(note.source_urls || []).slice(0, 2).map((url) => (
                      <a class="source-link" data-source-link data-source-url={url} href={url} rel="noopener noreferrer" target="_blank" aria-label={`${copy.sourceLink}: ${sourceLabel(url)}`} title={url}>{sourceLabel(url)} ↗</a>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))}
      </ul>
      </details>

      <!-- 只做兩件事,都不是捲動動畫:
           ① 有 JS 就把 <details> 收起來(無 JS 時 HTML 停在 open,內容照樣看得到)
           ② 點頁首那個連結、或點國旗列的某一國時,先展開再讓瀏覽器自己捲過去
           捲動本身完全交給原生錨點 + CSS scroll-behavior(reduced-motion 下不平滑)。
           放在元素之後、就地執行:在畫到這一段之前就收合,不會先閃一下全展開。 -->
      <script is:inline>
        (function () {
          var world = document.getElementById('world');
          if (!world) return;
          world.open = false;
          document.addEventListener('click', function (ev) {
            var node = ev.target;
            if (!node || typeof node.closest !== 'function') return;
            if (node.closest('a[href="#world"], a[href^="#observance-"], a[href^="#regional-"]')) world.open = true;
          });
        })();
      </script>
      </Fragment>
    )}

    {sourceUrls.length > 0 && (
      <section class="topic-sources" id="sources">
        <div class="section-head">
          <h2>{copy.sources}</h2>
        </div>
        <p class="source-note">{copy.sourceNote}</p>
        <ul class="source-list">
          {sourceUrls.map((url) => (
            <li><a data-source-link data-source-url={url} href={url} rel="noopener noreferrer" target="_blank" title={url}>{sourceLabel(url)} ↗</a></li>
          ))}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section class="topic-related" id="related">
        <div class="section-head">
          <h2>{copy.related}</h2>
        </div>
        <ul class="related-list">
          {related.map((relatedTopic) => (
            <li><a data-topic-slug={relatedTopic.slug} href={withBase(`topic/${relatedTopic.slug}/`)}>{relatedTopic.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  // 店家/活動的 emoji 列:沿用 src/lib/reactions.mjs(與貼文、留言同一份實作)。
  // 這裡只負責把每個 [data-card-reactions] 容器接上去,行為一律由 reactions.mjs 決定。
  import { createReactions } from '../../lib/reactions.mjs';
  import { track } from '../../lib/analytics.mjs';

  const topicArticle = document.querySelector('article[data-topic-slug]');
  document.querySelectorAll('[data-source-link]').forEach((link) => {
    link.addEventListener('click', () => {
      let domain = '';
      try { domain = new URL(link.dataset.sourceUrl || link.href).hostname.replace(/^www\./, ''); } catch {}
      track('source_click', {
        topic_slug: topicArticle?.dataset.topicSlug,
        source_domain: domain,
        locale: document.documentElement.lang,
      });
    });
  });
  document.querySelectorAll('[data-local-action]').forEach((link) => {
    link.addEventListener('click', () => {
      track('local_action_click', {
        topic_slug: topicArticle?.dataset.topicSlug,
        action: link.dataset.localAction,
        target_type: link.dataset.localType,
        target_id: link.dataset.localId,
        locale: document.documentElement.lang,
      });
    });
  });

  const cfgNode = document.querySelector('[data-card-reactions-config]');
  if (cfgNode) {
    let cfg = null;
    try {
      cfg = JSON.parse(cfgNode.textContent);
    } catch {
      cfg = null; // 設定壞掉就整段不掛,寧可沒有 emoji 也不要半殘的控制項
    }
    if (cfg) {
      // counts 為 null 時 reactions.mjs 一律畫 0(靜態資料沒有 reaction 計數,權威在 D1)。
      // summary 回來之後用同一支重畫一次,計數才是真值——reactions.mjs 只讀不改。
      const mount = (box, counts) => {
        const row = createReactions({
          targetType: box.dataset.targetType, // 'place' | 'event'(契約 §4 已含這兩種)
          targetId: box.dataset.targetId,
          emojis: cfg.emojis,
          counts: counts || undefined,
          api: cfg.api,
          i18n: cfg.i18n,
          classes: {
            btn: 'card-reaction',
            emoji: 'card-reaction-emoji',
            count: 'card-reaction-count',
            status: 'card-reaction-status',
            mine: 'is-mine',
            error: 'is-error',
          },
        });
        box.textContent = '';
        row.nodes.forEach((node) => box.appendChild(node));
      };

      const boxes = Array.prototype.filter.call(
        document.querySelectorAll('[data-card-reactions]'),
        (box) => !!box.dataset.targetId
      );
      boxes.forEach((box) => mount(box, null));

      // 真實計數:一種 target_type 一支請求,一次最多 100 個 id(契約 §4 的 summary)。
      // 失敗就靜靜留著 0——不清空、不顯示錯誤內容。
      if (cfg.api) {
        ['place', 'event'].forEach((type) => {
          const mine = boxes.filter((box) => box.dataset.targetType === type);
          const ids = mine.map((box) => box.dataset.targetId).slice(0, 100);
          if (ids.length === 0) return;
          fetch(
            cfg.api +
              '/v1/reactions/summary?target_type=' +
              encodeURIComponent(type) +
              '&ids=' +
              ids.map(encodeURIComponent).join(','),
            { credentials: 'include' } // anon_id 是跨站 cookie
          )
            .then((res) => (res.ok ? res.json() : null))
            .then((data) => {
              const items = (data && data.items) || null;
              if (!items) return;
              mine.forEach((box) => {
                const hit = items[box.dataset.targetId];
                if (hit && hit.reactions) mount(box, hit.reactions);
              });
            })
            .catch(() => {});
        });
      }
    }
  }
</script>

<style>
  .topic > section {
    margin-block-end: clamp(2.5rem, 6vw, 4rem);
    scroll-margin-block-start: 1rem;
  }
  .empty {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
  .topic-answers,
  .topic-sources,
  .topic-related {
    margin-block-end: clamp(2.5rem, 6vw, 4rem);
    scroll-margin-block-start: 1rem;
  }
  .answer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 0;
  }
  .answer-card {
    margin: 0;
    padding: 1rem 1.25rem;
    border-inline-start: 0.25rem solid var(--color-primary);
    background: var(--color-white);
    box-shadow: var(--shadow-card);
  }
  .answer-card dt {
    margin-block-end: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-primary);
  }
  .answer-card dd {
    margin: 0;
    color: var(--color-ink-soft);
    line-height: 1.55;
  }
  .source-note,
  .updated-note {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
  .source-list,
  .related-list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-inline-start: 1.25rem;
  }
  .source-list a,
  .related-list a,
  .source-link {
    color: var(--color-primary);
    overflow-wrap: anywhere;
  }
  .country-sources {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
  .source-link {
    font-size: var(--text-xs);
  }
  .section-emoji {
    margin-inline-end: 0.4rem;
  }
  .section-head .eyebrow {
    flex: 0 0 100%;
    color: var(--color-accent-dark);
  }

  /* ── 頁首 = 第一屏的**上半**(不是整屏)──
     窄螢幕完全不鎖高;桌機的高度分配關在 @media (min-width: 1024px) 裡:
     head-main 約佔第一屏 40%,剩下 58% 留給三區塊,所以三區塊在第一眼就看得到。 */
  .topic-head {
    display: flex;
    flex-direction: column;
    padding-block-end: 1.25rem;
    margin-block-end: clamp(2rem, 5vw, 3rem);
    border-block-end: 0.0625rem solid var(--color-line);
  }
  .head-main {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
  }
  /* cover 圖:16:9(= 1200×675,Google Discover 建議尺寸)。
     object-fit: cover 讓之後換上的真圖不管內部構圖如何都不會撐歪版面。 */
  .topic-cover {
    margin: 0;
    min-width: 0;
  }
  .topic-cover img {
    display: block;
    inline-size: 100%;
    aspect-ratio: 1200 / 675;
