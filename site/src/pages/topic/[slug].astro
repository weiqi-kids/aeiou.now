  .card-reactions :global(button.card-reaction) {
    cursor: pointer;
  }
  .card-reactions :global(button.card-reaction:hover:not(:disabled)) {
    border-color: var(--color-primary-line);
  }
  .card-reactions :global(.card-reaction[aria-pressed='true']) {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .card-reactions :global(.card-reaction[aria-pressed='true'] .card-reaction-count) {
    color: var(--color-accent-dark);
    font-weight: 700;
  }
  /* 送出中:同一顆按鈕 disable(連點只送一次) */
  .card-reactions :global(.card-reaction:disabled) {
    cursor: progress;
    opacity: 0.55;
  }
  /* 失敗:不假裝成功——警示外框 + 旁邊一行 role=status 文字 */
  .card-reactions :global(.card-reaction.is-error) {
