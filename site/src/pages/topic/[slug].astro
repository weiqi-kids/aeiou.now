---
// Topic 頁 = 一個看板(草案 §44 的版面,逐段照抄它的順序):
//
//   ❤️ 標題 + 各地叫法(情人節 / バレンタイン / …)
//   🌎 How the World Celebrates
//   🇺🇸 🇯🇵 🇰🇷 🇹🇼 …          ← 國旗列
//   🔥 Trending [8H][24H][72H][7D][1M][3M][1Y]
//   💬 People Are Talking About  ← 這一頁存在的理由,版面主體
//   📍 Near You
//   🎉 Events
//   🌎 Ask the World
//
// 2026-08-11 資訊架構重做的重點:
//   ① 討論回到主位。前一版把「全世界怎麼過」做成招牌大圖、討論縮成半頁以下的小面板,
//      那是雜誌文章網站的排法;這是主題頁論壇,討論串就是內容本身。
//   ② 國旗列是新的(§44 有、前一版沒有)。國旗用 Unicode regional indicator 由 ISO 3166-1
//      alpha-2 組出來(見 lib/format.mjs),不用圖檔、不用外部 CDN。
//   ③ Trending 從六窗變成七窗:8H 是動態層(Worker feed),24H 以上是靜態層。
//   ④ 「歷史精華」不在 §44 的清單裡,資料也恆為空,所以降到最低視覺權重、收在最後。
//
// 資料現實:facts.json 的 countries 為空的 Topic(如長青的 ask-the-world)不會有
// 「全世界怎麼過」與國旗列,那兩段就整段不出現——空著比硬做假的好。
import BaseLayout from '../../layouts/BaseLayout.astro';
import DiscussionRoom from '../../components/DiscussionRoom.astro';
import TrendWindows from '../../components/TrendWindows.astro';
import { t, tOr } from '../../lib/i18n.mjs';
import { LOCALE, WINDOWS } from '../../lib/config.mjs';
import { monthDay, dateTime, countryFlag } from '../../lib/format.mjs';
import { withBase } from '../../lib/paths.mjs';
import {
  listTopicIds, getTopicBundle, placesForTopic, eventsForTopic, countryName,
  customsText, scoresFor, topicRowBySlug, globalRankOf, aliasNames,
  relatedTopics, hotTopics,
} from '../../lib/data.mjs';

export function getStaticPaths() {
  // 模組頂層無法 await 匯入的環境:直接同步讀 data 目錄(build time)
  return listTopicIds()
    .map((topicId) => {
      const { facts } = getTopicBundle(topicId);
      return facts && facts.slug ? { params: { slug: facts.slug }, props: { topicId } } : null;
    })
    .filter(Boolean);
}

const ASK_THE_WORLD_SLUG = 'ask-the-world'; // §45 的跨國提問就是這個長青 Topic

const { topicId } = Astro.props;
const { facts, i18n, highlightItems } = getTopicBundle(topicId);
const loc = (i18n && i18n.locales && i18n.locales[LOCALE]) || {};
const title = loc.title || (facts && facts.canonical_name) || topicId;
const aliases = aliasNames(topicId, title);
// popularity_rank 是資料裡本來就有的順位,拿來決定「先讀哪一國」
const countries = ((facts && facts.countries) || [])
  .slice()
  .sort((a, b) => (a.popularity_rank || 99) - (b.popularity_rank || 99));
const scores = scoresFor(topicId);
const ranks = Object.fromEntries(WINDOWS.map((win) => [win, globalRankOf(topicId, win)]));
const hlList = highlightItems;
const places = placesForTopic(topicId);
const events = eventsForTopic(topicId);
const row = topicRowBySlug(facts && facts.slug) || {};
const category = (facts && facts.category) || row.category;
const isPerennial = (facts && facts.is_perennial) || row.is_perennial;
const isAskTheWorld = (facts && facts.slug) === ASK_THE_WORLD_SLUG;
const askHref = withBase(`topic/${ASK_THE_WORLD_SLUG}/`);

// 導覽列尾端的「直接跳進看板」在 Topic 頁上改列**相關議題**(facts.json 的 relations,
// 草案 §48 Topic Graph);沒有相關議題就退回熱門 Topic。當前這一頁自己不列(BaseLayout 會濾掉)。
const related = relatedTopics(topicId, 2);
const navTopics = related.length ? related : hotTopics(3);
---

<BaseLayout
  title={`${title} — aeiou.now`}
  description={loc.summary}
  navTopics={navTopics}
  currentTopicId={topicId}
>
  <article class="topic">
    <header class="topic-head">
      <ul class="badge-row">
        {category && (
          <li><span class="badge badge--primary">{tOr(`category.${category}`, category)}</span></li>
        )}
        {isPerennial ? <li><span class="badge">{t('topic.perennial')}</span></li> : null}
      </ul>
      <h1>{title}</h1>
      {aliases.length > 0 && (
        <p class="topic-aliases">
          <span class="visually-hidden">{t('topic.also_known_as')}</span>
          {aliases.join(' / ')}
        </p>
      )}
      {loc.summary && <p class="topic-lede measure">{loc.summary}</p>}
    </header>

    {countries.length > 0 && (
      <Fragment>
      <section class="zone-world" id="world">
        <div class="section-head">
          <h2><span class="section-emoji" aria-hidden="true">🌎</span>{t('topic.how_world_celebrates')}</h2>
        </div>
        <ul class="country-list">
          {countries.map((c) => (
            <li class="country" id={`country-${c.country_code}`}>
              <div class="country-when">
                <span class="country-date">{monthDay(c.observed_date)}</span>
                {c.date_range_end && (
                  <span class="country-date-end">– {monthDay(c.date_range_end)}</span>
                )}
                <span class="country-when-label">{t('topic.local_date')}</span>
                {c.date_rule && <span class="country-rule">{c.date_rule}</span>}
              </div>
              <div class="country-body">
                <h3 class="country-name">
                  <span class="country-flag" aria-hidden="true">{countryFlag(c.country_code)}</span>
                  {countryName(c.country_code)}
                  <span class="local-name">{c.local_name}</span>
                </h3>
                {customsText(i18n, c.country_code) && (
                  <p class="country-customs">{customsText(i18n, c.country_code)}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>

      <nav class="flag-band" aria-label={t('topic.countries_label')}>
        {countries.map((c) => (
          <a class="flag-chip" href={`#country-${c.country_code}`}>
            <span class="flag-glyph" aria-hidden="true">{countryFlag(c.country_code)}</span>
            <span class="flag-name">{countryName(c.country_code)}</span>
          </a>
        ))}
      </nav>
      </Fragment>
    )}

    <section class="zone-trend" id="trending">
      <div class="section-head">
        <h2><span class="section-emoji" aria-hidden="true">🔥</span>{t('topic.trending')}</h2>
        <p class="section-note">{t('heat.scale_note')}</p>
      </div>
      <TrendWindows topicId={topicId} scores={scores} ranks={ranks} discussionHref="#talking" />
    </section>

    <!-- 💬 討論串:這一頁的主體,不是附掛在文章底下的留言區 -->
    <section class="zone-talk" id="talking">
      <div class="section-head">
        <p class="eyebrow">{t('marker.now')}</p>
        <h2><span class="section-emoji" aria-hidden="true">💬</span>{t('topic.people_talking')}</h2>
      </div>
      <DiscussionRoom topicId={topicId} />
    </section>

    <section class="zone-local" id="nearby">
      <div class="section-head">
        <h2><span class="section-emoji" aria-hidden="true">📍</span>{t('topic.near_you')}</h2>
      </div>
      {places.length === 0 && <p class="empty">{t('common.empty')}</p>}
      <ul class="card-list">
        {places.map((pl) => (
          <li class="mini-card">
            <h3>
              <span class="mini-flag" aria-hidden="true">{countryFlag(pl.country_code)}</span>
              {pl.name}
            </h3>
            {pl.descriptions && pl.descriptions[LOCALE] && <p>{pl.descriptions[LOCALE]}</p>}
            {pl.address && <p class="card-meta">{pl.address}</p>}
            {pl.map_url && (
              <a class="card-link" href={pl.map_url} rel="noopener" target="_blank">
                {t('topic.navigate')} <span aria-hidden="true">↗</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section class="zone-local" id="events">
      <div class="section-head">
        <h2><span class="section-emoji" aria-hidden="true">🎉</span>{t('topic.events')}</h2>
      </div>
      {events.length === 0 && <p class="empty">{t('common.empty')}</p>}
      <ul class="card-list">
        {events.map((ev) => (
          <li class="mini-card">
            <h3>
              <span class="mini-flag" aria-hidden="true">{countryFlag(ev.country_code)}</span>
              {ev.name}
            </h3>
            {ev.descriptions && ev.descriptions[LOCALE] && <p>{ev.descriptions[LOCALE]}</p>}
            <p class="card-meta">
              {ev.venue}
              {ev.start_at && ` · ${dateTime(ev.start_at)}`}
              {ev.end_at && ` – ${dateTime(ev.end_at)}`}
            </p>
            {ev.ticket_url && (
              <a class="card-link" href={ev.ticket_url} rel="noopener" target="_blank">
                {t('topic.tickets')} <span aria-hidden="true">↗</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>

    <!-- 🌎 Ask the World(§45):M1 只做入口,跨國提問功能屬後續里程碑。
         ask-the-world 自己就是那個長青 Topic,所以在它自己的頁面上不再放入口。 -->
    {!isAskTheWorld && (
      <section class="zone-ask" id="ask">
        <a class="ask-link" href={askHref}>
          <span class="ask-emoji" aria-hidden="true">🌎</span>
          <span class="ask-body">
            <span class="ask-title">{t('topic.ask_the_world')}</span>
            <span class="ask-cta">{t('topic.ask_the_world_cta')}</span>
          </span>
          <span class="ask-arrow" aria-hidden="true">→</span>
        </a>
      </section>
    )}

    <!-- 歷史精華:不在 §44 的清單裡,資料恆為空,收在最後、最低視覺權重 -->
    <section class="zone-highlights" id="highlights">
      <h2 class="quiet-head">{t('topic.highlights')}</h2>
      {hlList.length === 0 && <p class="empty">{t('topic.highlights_empty')}</p>}
      {hlList.map((hl) => {
        const text =
          hl.original_locale === LOCALE
            ? hl.content
            : (hl.translations && hl.translations[LOCALE]) || hl.content;
        const translated = hl.original_locale !== LOCALE && hl.translations && hl.translations[LOCALE];
        return (
          <article class="highlight">
            <p class="highlight-content">{text}</p>
            <p class="highlight-meta">
              {countryName(hl.country_code)} · {hl.cycle_label}
            </p>
            {translated && (
              <details>
                <summary>{t('post.show_original')}</summary>
                <p class="highlight-original">{hl.content}</p>
              </details>
            )}
          </article>
        );
      })}
    </section>
  </article>
</BaseLayout>

<style>
  .topic > section {
    margin-block-end: clamp(2.5rem, 6vw, 4rem);
    scroll-margin-block-start: 1rem;
  }
  .empty {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
  .section-emoji {
    margin-inline-end: 0.4rem;
  }
  .section-head .eyebrow {
    flex: 0 0 100%;
    color: var(--color-accent-dark);
  }

  /* ── 標題區:分類 → 大標 → 各地叫法 → 導言 ── */
  .topic-head {
    padding-block-end: 1.25rem;
    margin-block-end: clamp(2rem, 5vw, 3rem);
    border-block-end: 0.0625rem solid var(--color-line);
  }
  .topic-head h1 {
    margin: 0.75rem 0 0.5rem;
  }
  /* 同一個議題在各地的名字(§44 標題下那一行) */
  .topic-aliases {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.4;
    color: var(--color-ink-muted);
  }
  .topic-lede {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* ── 🌎 全世界怎麼過 ── */
  .country-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .country {
    display: grid;
    gap: 0.5rem 2rem;
    padding-block: clamp(1rem, 3vw, 1.5rem);
    border-block-start: 0.0625rem solid var(--color-line);
    scroll-margin-block-start: 1rem;
  }
  .country:first-child {
    border-block-start: 0;
    padding-block-start: 0;
  }
  .country-when {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
  }
  .country-date {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-accent-dark);
  }
  .country-date-end {
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--color-accent-dark);
  }
  .country-when-label {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    flex-basis: 100%;
  }
  .country-rule {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
    flex-basis: 100%;
  }
  .country-name {
    margin: 0 0 0.375rem;
    color: var(--color-primary);
  }
  .country-flag {
    margin-inline-end: 0.4rem;
  }
  .local-name {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    margin-inline-start: 0.6rem;
    font-weight: 400;
  }
  .country-customs {
    margin: 0;
    max-width: 42rem;
    font-size: var(--text-sm);
  }

  /* ── 🇺🇸🇯🇵🇹🇼… 國旗列:整段色帶,是這一頁「跨國」身分的招牌 ── */
  .flag-band {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    background: var(--color-primary-soft);
    border-block: 0.0625rem solid var(--color-primary-line);
    padding: 1rem clamp(1rem, 4vw, 2rem);
    margin-inline: calc(-1 * clamp(1rem, 4vw, 2rem));
    margin-block-end: clamp(2.5rem, 6vw, 4rem);
  }
  .flag-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--color-primary);
  }
  .flag-chip:hover .flag-name {
    text-decoration: underline;
  }
  .flag-glyph {
    font-size: var(--text-xl);
    line-height: 1;
  }
  .flag-name {
    font-size: var(--text-xs);
  }

  /* ── 💬 討論串:整頁的主體,給它最大的上下留白與最寬的版心 ── */
  .zone-talk {
    margin-block-end: clamp(3rem, 8vw, 5rem);
  }

  /* ── 🌎 Ask the World 入口 ── */
  .ask-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: var(--color-text);
    background: var(--color-white);
    border: 0.0625rem solid var(--color-line);
    border-inline-start: 0.25rem solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
  }
  .ask-link:hover {
    border-inline-start-color: var(--color-accent);
  }
  .ask-emoji {
    font-size: var(--text-xl);
    line-height: 1;
  }
  .ask-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .ask-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-primary);
  }
  .ask-cta {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
  .ask-arrow {
    margin-inline-start: auto;
    color: var(--color-accent);
  }

  /* ── 📍🎉 在地資訊:低權重卡片 ── */
  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .mini-card {
    background: var(--color-white);
    border: 0.0625rem solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    box-shadow: var(--shadow-card);
  }
  .mini-card h3 {
    font-size: var(--text-lg);
    margin: 0 0 0.375rem;
  }
  .mini-flag {
    margin-inline-end: 0.4rem;
  }
  .mini-card p {
    font-size: var(--text-sm);
    margin: 0 0 0.5rem;
    color: var(--color-ink-soft);
  }
  .card-meta {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
  .card-link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent-dark);
    text-decoration: none;
  }
  .card-link:hover {
    text-decoration: underline;
  }

  /* ── 歷史精華:安靜到底,不跟討論搶版面 ── */
  .quiet-head {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    margin: 0 0 0.5rem;
    border-block-start: 0.0625rem solid var(--color-line);
    padding-block-start: 0.75rem;
  }
  .highlight {
    border-inline-start: 0.1875rem solid var(--color-line-strong);
    padding-inline-start: 1rem;
    margin-block-end: 1.25rem;
    max-width: 42rem;
  }
  .highlight-content {
    margin: 0 0 0.5rem;
    font-size: var(--text-sm);
    line-height: 1.55;
  }
  .highlight-meta {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    margin: 0;
  }
  .highlight-original {
    color: var(--color-ink-soft);
    border-inline-start: 0.125rem solid var(--color-line);
    padding-inline-start: 0.75rem;
  }
  details summary {
    cursor: pointer;
    color: var(--color-primary);
    font-size: var(--text-xs);
    margin-block-start: 0.5rem;
  }

  @media (min-width: 768px) {
    .country {
      grid-template-columns: minmax(9rem, 14rem) minmax(0, 1fr);
    }
    .card-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .topic-head h1 {
      font-size: var(--text-3xl);
      line-height: 1.1;
    }
  }
</style>
