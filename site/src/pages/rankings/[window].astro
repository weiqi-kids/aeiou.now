---
// 排行頁:六個 window 各一頁(24h/72h/7d/1m/3m/1y;8h 屬動態,不出靜態)
// 視覺重點:① 六個時窗做成可互相切換的分頁列(以前要手改網址)
//           ② 名次感靠襯線大字號碼 + 前三名的規線與朱紅
//           ③ 分數不上畫面,只呈現熱度級距(見 src/lib/heat.mjs)
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeatMeter from '../../components/HeatMeter.astro';
import { t, tOr } from '../../lib/i18n.mjs';
import { WINDOWS } from '../../lib/config.mjs';
import { getGlobalRanking, getTopicsIndex, countryName, coverPath } from '../../lib/data.mjs';
import { withBase } from '../../lib/paths.mjs';
import { siteDescription, SITE_OVERVIEW_IMAGE_PATH } from '../../lib/seo.mjs';

export function getStaticPaths() {
  return ['24h', '72h', '7d', '1m', '3m', '1y'].map((win) => ({ params: { window: win } }));
}

const { window: win } = Astro.params;
const ranking = getGlobalRanking(win) || { items: [], thin: true };
// thin = 這個時窗的排名筆數低於門檻(見 scripts/lib/content-depth.mjs)。
// 2026-08-19:六個時窗各只有一筆,內容幾乎相同,Google 已把其中兩頁判為
// Crawled/Discovered - currently not indexed。與其送空頁,不如自己標 noindex
// 並退出 sitemap;等分數管線上線、筆數夠了會自動恢復索引,不需要改碼。
const indexable = !ranking.thin;
const byId = new Map(getTopicsIndex().map((topic) => [topic.topic_id, topic]));
const items = (ranking.items || [])
  .slice()
  .sort((a, b) => a.rank - b.rank)
  .map((item) => ({ ...item, topic: byId.get(item.topic_id) }));
const representativeTopic = items
  .map((item) => item.topic)
  .find((topic) => coverPath(topic?.slug));
const representativeCover = representativeTopic ? coverPath(representativeTopic.slug) : null;
---

<BaseLayout
  title={`${t('rankings.title')} — ${t(`rankings.window.${win}`)}`}
  description={`${t('rankings.title')} · ${t(`rankings.window.${win}`)} · ${siteDescription()}`}
  pageType="CollectionPage"
  indexable={indexable}
  image={withBase(representativeCover || SITE_OVERVIEW_IMAGE_PATH)}
  imageAlt={representativeTopic?.title || t('rankings.title')}
>
  <header class="rank-head">
    <h1>{t('rankings.title')}</h1>
    <p class="eyebrow" id="window-label">{t('rankings.window_label')}</p>
    <nav class="window-nav" aria-labelledby="window-label">
      {WINDOWS.map((w) => (
        <a
          href={withBase(`rankings/${w}/`)}
          aria-current={w === win ? 'page' : undefined}
        >
          {t(`rankings.window.${w}`)}
        </a>
      ))}
    </nav>
  </header>

  {items.length === 0 && <p class="empty">{t('common.empty')}</p>}

  <ol class="ranking-list">
    {items.map((item) => {
      const topic = item.topic || {};
      const codes = topic.country_codes || [];
      return (
        <li class:list={['ranking-item', { top: item.rank <= 3 }]}>
          <a class="ranking-row" href={withBase(`topic/${topic.slug || item.slug}/`)}>
            <span class="rank" aria-hidden="true">{item.rank}</span>
            <span class="rank-main">
              <span class="rank-title">{topic.title || item.slug}</span>
              {topic.summary && <span class="rank-summary">{topic.summary}</span>}
              <span class="rank-meta">
                {topic.category && (
                  <span class="badge badge--primary">
                    {tOr(`category.${topic.category}`, topic.category)}
                  </span>
                )}
                {codes.length > 0 && (
                  <span class="rank-countries">
                    {codes.slice(0, 3).map((code) => countryName(code)).join(' · ')}
                    {codes.length > 3 ? ` +${codes.length - 3}` : ''}
                  </span>
                )}
                <HeatMeter tier={item.tier} />
              </span>
            </span>
          </a>
        </li>
      );
    })}
  </ol>

  <p class="scale-note">{t('heat.scale_note')}</p>
</BaseLayout>

<style>
  .rank-head {
    padding-block-end: 1.5rem;
    margin-block-end: 2rem;
    border-block-end: 0.0625rem solid var(--color-line);
  }
  .rank-head h1 {
    margin: 0 0 1.5rem;
  }
  .rank-head .eyebrow {
    margin-block-end: 0.625rem;
  }

  /* 時窗切換:分頁列。一律折行,不橫捲——橫捲會把後面的時窗切在窄螢幕視窗外,點不到。 */
  .window-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .window-nav a {
    flex: 0 1 auto;
    font-size: var(--text-sm);
    text-decoration: none;
    border: 0.0625rem solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    padding: 0.2rem 1.1rem;
    color: var(--color-ink-soft);
    background: var(--color-white);
    white-space: nowrap;
  }
  .window-nav a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .window-nav a[aria-current='page'] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
    font-weight: 700;
  }

  .ranking-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ranking-item {
    border-block-start: 0.0625rem solid var(--color-line);
  }
  .ranking-item:first-child {
    border-block-start: 0.125rem solid var(--color-text);
  }
  /* 前三名:朱紅號碼 + 較粗的上緣規線,名次感不靠底色 */
  .ranking-item.top .rank {
    color: var(--color-accent);
  }
  .ranking-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.75rem 1rem;
    align-items: baseline;
    padding-block: 1.25rem;
    text-decoration: none;
    color: var(--color-text);
  }
  .ranking-row:hover .rank-title {
    color: var(--color-accent-dark);
    text-decoration: underline;
  }
  .rank {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .rank-main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }
  .rank-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-primary);
  }
  .rank-summary {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    max-width: 42rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .rank-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .rank-countries {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
  .empty {
    color: var(--color-ink-muted);
  }
  .scale-note {
    margin-block-start: 2rem;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  @media (min-width: 768px) {
    .ranking-row {
      grid-template-columns: 5rem minmax(0, 1fr);
      padding-block: 1.75rem;
    }
    .rank {
      font-size: var(--text-2xl);
    }
    .rank-title {
      font-size: var(--text-xl);
    }
  }
</style>
