---
// 首頁 = 全球熱門(2026-08-11 用戶當面拍板的階層,這一版照它重做)。
//
//   World
//   └── Topic(看板)   情人節、問世界
//       ├── 議題介紹    ← Topic 頁的靜態內容,不在首頁
//       └── Post(討論串) N 則貼文  ← 首頁在每個 Topic 底下就要看得到
//           └── Comment
//
// 首頁 = **Topic 清單,每個 Topic 底下掛該議題的 N 則 Post**。就這樣,沒有別的區塊。
//
// 這一輪刪掉的三件事(用戶原話:「你是沒有階層概念嗎?」):
//   ① 時窗切換(24H/72H/7D/1M/3M/1Y)整組——那是**排行榜層**的東西,只在 /rankings/<窗>/。
//      首頁只呈現「現在最熱」,不讓人選時間範圍,排序固定 24h 全球熱度。
//      (Topic 頁 §44 的七窗與排行榜頁的時窗切換都還在,那兩處是規格,沒動。)
//   ② #today 熱門話題整段——它是導覽列四種排序之一,有自己的頁 /topics/today/,首頁不重複。
//   ③ #talking 大家正在聊整段——首頁每個 Topic 底下本來就有 Post,貼文就是「正在聊」的內容;
//      另開一區把同一批資料抽出來重排一次 = 同一批資料在同一頁出現兩次 = 階層沒分清楚。
//      對應的 PeopleTalking.astro 一併刪除。
//
// 留下的:草案 §54 第一段 Global Trending + §55「首頁必須有現在」——「現在」不是靠標語喊的,
// 是靠每個看板底下那幾則剛發的貼文(sort=new,見 TopicPosts.astro)。
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicBoard from '../components/TopicBoard.astro';
import { t } from '../lib/i18n.mjs';
import { withBase } from '../lib/paths.mjs';
import { globalRankRows } from '../lib/data.mjs';

// 首頁列全球熱度(24h)前 10 個 Topic,超過的走排行榜。
const HOME_TOPIC_LIMIT = 10;
const HOME_WINDOW = '24h';
const rows = globalRankRows(HOME_WINDOW).slice(0, HOME_TOPIC_LIMIT);
---

<BaseLayout title={`aeiou.now — ${t('nav.global_trending')}`} activeSort="global">
  <section class="board" id="trending">
    <div class="section-head">
      <p class="eyebrow">{t('marker.trending')}</p>
      <h2><span class="section-emoji" aria-hidden="true">🔥</span>{t('nav.global_trending')}</h2>
      <a class="section-link" href={withBase(`rankings/${HOME_WINDOW}/`)}>
        {t('home.rankings_cta')} <span aria-hidden="true">→</span>
      </a>
    </div>

    <TopicBoard rows={rows} win={HOME_WINDOW} empty={t('common.empty')} withPosts />
  </section>
</BaseLayout>

<style>
  .board {
    margin-block-end: clamp(2.5rem, 6vw, 4rem);
    scroll-margin-block-start: 1rem;
  }
  .section-head .eyebrow {
    flex: 0 0 100%;
    order: -1;
    color: var(--color-accent-dark);
  }
  .section-emoji {
    margin-inline-end: 0.4rem;
  }
  .section-link {
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-accent-dark);
    font-weight: 600;
    white-space: nowrap;
  }
  .section-link:hover {
    text-decoration: underline;
  }
</style>
