---
// 首頁 = 看板列表(草案 §54 逐字的六段順序):
//   Global Trending → Country Trending → Today's Topics → People Are Talking → Nearby → Events
// 加上 §55:首頁要回答的是「現在世界正在發生什麼」,所以 NOW / TRENDING / NEW / ACTIVE
// 四個標記直接掛在段落抬頭上,而不是靠一段介紹文字去講。
//
// 2026-08-11 資訊架構重做刪掉的東西(前一輪自行編寫、非用戶提供,一併從 i18n 七檔移除):
//   大標語(home.lede)、產品介紹段(home.intro)、統計數字排(home.stat_*)、頁尾七語系名稱列。
//   統計數字那一排尤其有害:它等於在首頁昭告「我們只有 N 個議題」。
//
// M1 資料現實(照實留白,不假造):
//   · Country Trending —— seed 的 topic_scores 只有 scope='global',沒有國家別排行,這一段留空狀態。
//   · People Are Talking —— 動態層,沒有跨 Topic 端點,前端對每個 Topic 各打一次現有 feed 端點合併。
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicRow from '../components/TopicRow.astro';
import PeopleTalking from '../components/PeopleTalking.astro';
import { t } from '../lib/i18n.mjs';
import { LOCALE, WINDOWS } from '../lib/config.mjs';
import { withBase } from '../lib/paths.mjs';
import { countryFlag, dateTime } from '../lib/format.mjs';
import {
  globalRankRows, todaysTopics, allPlacesByCity, allEvents, cityName,
} from '../lib/data.mjs';

const boards = WINDOWS.map((win) => ({ win, rows: globalRankRows(win) }));
const today = todaysTopics();
const cities = allPlacesByCity();
const events = allEvents();

// People Are Talking 要打哪幾個 Topic 的 feed:照 24h 排行的順序,取前幾名。
const talkTopics = (boards.find((b) => b.win === '24h') || { rows: [] }).rows
  .map((row) => row.topic)
  .filter((topic) => topic && topic.topic_id)
  .slice(0, 6);

const sections = [
  { id: 'trending', label: t('home.global_trending') },
  { id: 'country-trending', label: t('home.country_trending') },
  { id: 'today', label: t('home.today_topics') },
  { id: 'talking', label: t('home.people_talking') },
  { id: 'nearby', label: t('home.nearby') },
  { id: 'events', label: t('home.events') },
];
---

<BaseLayout title={`aeiou.now — ${t('home.global_trending')}`}>
  <nav class="board-nav" aria-label={t('home.sections_label')}>
    {sections.map((section) => (
      <a class="board-nav-link" href={`#${section.id}`}>{section.label}</a>
    ))}
  </nav>

  <!-- ① Global Trending(§54 第一段 / §46 的時窗切換) -->
  <section class="board" id="trending">
    <div class="section-head">
      <p class="eyebrow">{t('marker.trending')}</p>
      <h2><span class="section-emoji" aria-hidden="true">🔥</span>{t('home.global_trending')}</h2>
      <a class="section-link" href={withBase('rankings/24h/')}>
        {t('home.rankings_cta')} <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="board-windows" data-board>
      <div
        class="board-tabs"
        role="tablist"
        aria-label={t('rankings.window_label')}
        hidden
        data-board-tabs
      >
        {WINDOWS.map((win) => (
          <button
            type="button"
            role="tab"
            class="board-tab"
            data-board-window={win}
            aria-selected={win === '24h' ? 'true' : 'false'}
          >
            {t(`rankings.window.${win}`)}
          </button>
        ))}
      </div>

      {boards.map((board) => (
        <div class="board-panel" data-board-panel={board.win}>
          <p class="board-panel-name">{t(`rankings.window.${board.win}`)}</p>
          {board.rows.length === 0 && <p class="empty">{t('common.empty')}</p>}
          <ol class="board-list">
            {board.rows.map((row) => (
              <TopicRow topic={row.topic} rank={row.rank} win={board.win} />
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <!-- ② Country Trending(§54 第二段):M1 沒有國家別排行資料,如實留空,不假造 -->
  <section class="board" id="country-trending">
    <div class="section-head">
      <p class="eyebrow">{t('marker.trending')}</p>
      <h2><span class="section-emoji" aria-hidden="true">🌍</span>{t('home.country_trending')}</h2>
    </div>
    <p class="empty">{t('home.country_trending_empty')}</p>
  </section>

  <!-- ③ Today's Topics(§54 第三段):當令與否只看資料裡的 observed_date 與 is_perennial -->
  <section class="board" id="today">
    <div class="section-head">
      <p class="eyebrow">{t('marker.new')}</p>
      <h2><span class="section-emoji" aria-hidden="true">🆕</span>{t('home.today_topics')}</h2>
    </div>
    {today.length === 0 && <p class="empty">{t('home.today_topics_empty')}</p>}
    <ul class="board-list">
      {today.map((topic) => <TopicRow topic={topic} marker={t('marker.new')} />)}
    </ul>
  </section>

  <!-- ④ People Are Talking(§54 第四段 / §55 的 NOW 與 ACTIVE):唯一的即時層 -->
  <section class="board" id="talking">
    <div class="section-head">
      <p class="eyebrow">{t('marker.now')}</p>
      <h2><span class="section-emoji" aria-hidden="true">💬</span>{t('home.people_talking')}</h2>
      <span class="badge badge--accent">{t('marker.active')}</span>
    </div>
    <PeopleTalking topics={talkTopics} />
  </section>

  <!-- ⑤ Nearby(§54 第五段):M1 沒有定位,城市就是誠實的分組單位 -->
  <section class="board" id="nearby">
    <div class="section-head">
      <h2><span class="section-emoji" aria-hidden="true">📍</span>{t('home.nearby')}</h2>
    </div>
    {cities.length === 0 && <p class="empty">{t('common.empty')}</p>}
    {cities.map((city) => (
      <div class="city">
        <h3 class="city-name">{cityName(city.city_code)}</h3>
        <ul class="mini-list">
          {city.places.map((pl) => (
            <li class="mini-card">
              <h4 class="mini-title">
                <span class="mini-flag" aria-hidden="true">{countryFlag(pl.country_code)}</span>
                {pl.name}
              </h4>
              {pl.descriptions && pl.descriptions[LOCALE] && <p>{pl.descriptions[LOCALE]}</p>}
              {pl.address && <p class="card-meta">{pl.address}</p>}
              <p class="mini-links">
                {pl.topics_ref.map((topic) => (
                  <a class="topic-chip" href={withBase(`topic/${topic.slug}/`)}>{topic.title}</a>
                ))}
                {pl.map_url && (
                  <a class="card-link" href={pl.map_url} rel="noopener" target="_blank">
                    {t('topic.navigate')} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <!-- ⑥ Events(§54 第六段) -->
  <section class="board" id="events">
    <div class="section-head">
      <h2><span class="section-emoji" aria-hidden="true">🎉</span>{t('home.events')}</h2>
    </div>
    {events.length === 0 && <p class="empty">{t('common.empty')}</p>}
    <ul class="mini-list">
      {events.map((ev) => (
        <li class="mini-card">
          <h4 class="mini-title">
            <span class="mini-flag" aria-hidden="true">{countryFlag(ev.country_code)}</span>
            {ev.name}
          </h4>
          {ev.descriptions && ev.descriptions[LOCALE] && <p>{ev.descriptions[LOCALE]}</p>}
          <p class="card-meta">
            {cityName(ev.city_code)} · {ev.venue}
            {ev.start_at && ` · ${dateTime(ev.start_at)}`}
            {ev.end_at && ` – ${dateTime(ev.end_at)}`}
          </p>
          <p class="mini-links">
            {ev.topics_ref.map((topic) => (
              <a class="topic-chip" href={withBase(`topic/${topic.slug}/`)}>{topic.title}</a>
            ))}
            {ev.ticket_url && (
              <a class="card-link" href={ev.ticket_url} rel="noopener" target="_blank">
                {t('topic.tickets')} <span aria-hidden="true">↗</span>
              </a>
            )}
          </p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<script>
  // 時窗切換是漸進增強:沒有 JS 就把六個時窗攤開成連續的列表,資訊一則不少。
  document.querySelectorAll('[data-board]').forEach((root) => {
    const tabs = root.querySelector('[data-board-tabs]');
    const panels = Array.from(root.querySelectorAll('[data-board-panel]'));
    if (!tabs || panels.length === 0) return;

    function select(win) {
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.boardPanel !== win;
      });
      tabs.querySelectorAll('[data-board-window]').forEach((btn) => {
        btn.setAttribute('aria-selected', btn.dataset.boardWindow === win ? 'true' : 'false');
      });
    }

    tabs.querySelectorAll('[data-board-window]').forEach((btn) => {
      btn.addEventListener('click', () => select(btn.dataset.boardWindow));
    });
    tabs.hidden = false;
    root.classList.add('is-tabbed');
    select('24h');
  });
</script>

<style>
  /* 看板分區導覽:一進站就看得到這個板有哪幾區,像看板頂端的分類列。 */
  .board-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 0.5rem 1.5rem;
    margin-block-end: 1rem;
    border-block-end: 0.0625rem solid var(--color-line);
  }
  .board-nav-link {
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-ink-soft);
    border: 0.0625rem solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    padding: 0.15rem 1rem;
    background: var(--color-white);
  }
  .board-nav-link:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .board {
    margin-block-end: clamp(2.5rem, 6vw, 4rem);
    scroll-margin-block-start: 1rem;
  }
  .section-head .eyebrow {
    flex: 0 0 100%;
    order: -1;
    color: var(--color-accent-dark);
  }
  .section-emoji {
    margin-inline-end: 0.4rem;
  }
  .section-link {
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-accent-dark);
    font-weight: 600;
    white-space: nowrap;
  }
  .section-link:hover {
    text-decoration: underline;
  }
  .empty {
    color: var(--color-ink-muted);
    max-width: 42rem;
  }

  .board-tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-block-end: 0.5rem;
    margin-block-end: 1rem;
  }
  .board-tab {
    flex: 0 0 auto;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    border: 0.0625rem solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    padding: 0.2rem 1.1rem;
    color: var(--color-ink-soft);
    background: var(--color-white);
    white-space: nowrap;
    cursor: pointer;
  }
  .board-tab:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .board-tab[aria-selected='true'] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
    font-weight: 700;
  }
  .board-panel-name {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin: 0 0 0.25rem;
  }
  /* tab 生效後就不必再重複印時窗名字(tab 本身就是) */
  .board-windows.is-tabbed .board-panel-name {
    display: none;
  }
  .board-panel {
    margin-block-end: 1.5rem;
  }
  .board-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .city {
    margin-block-end: 2rem;
  }
  .city-name {
    font-size: var(--text-lg);
    margin: 0 0 0.75rem;
    padding-block-end: 0.35rem;
    border-block-end: 0.0625rem solid var(--color-line);
    color: var(--color-ink-soft);
  }
  .mini-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .mini-card {
    background: var(--color-white);
    border: 0.0625rem solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    box-shadow: var(--shadow-card);
  }
  .mini-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    margin: 0 0 0.375rem;
    line-height: 1.3;
  }
  .mini-flag {
    margin-inline-end: 0.4rem;
  }
  .mini-card p {
    font-size: var(--text-sm);
    margin: 0 0 0.5rem;
    color: var(--color-ink-soft);
  }
  .card-meta {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
  .mini-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin: 0;
  }
  .topic-chip {
    font-size: var(--text-xs);
    text-decoration: none;
    color: var(--color-primary);
    background: var(--color-primary-soft);
    border: 0.0625rem solid var(--color-primary-line);
    border-radius: var(--radius-pill);
    padding: 0.1rem 0.8rem;
  }
  .card-link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent-dark);
    text-decoration: none;
  }
  .card-link:hover {
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .mini-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
