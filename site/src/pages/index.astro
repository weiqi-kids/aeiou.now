---
// 首頁 = 全球熱門(2026-08-11 用戶當面拍板的階層,這一版照它重做)。
//
//   World
//   └── Topic(看板)   情人節、問世界
//       ├── 議題介紹    ← Topic 頁的靜態內容,不在首頁
//       └── Post(討論串) N 則貼文  ← 首頁在每個 Topic 底下就要看得到
//           └── Comment
//
// 首頁 = **Topic 清單,每個 Topic 底下掛該議題的 N 則 Post**。就這樣,沒有別的區塊。
//
// 這一輪刪掉的三件事(用戶原話:「你是沒有階層概念嗎?」):
//   ① 時窗切換(24H/72H/7D/1M/3M/1Y)整組——那是**排行榜層**的東西,只在 /rankings/<窗>/。
//      首頁只呈現「現在最熱」,不讓人選時間範圍,排序固定 24h 全球熱度。
//      (Topic 頁 §44 的七窗與排行榜頁的時窗切換都還在,那兩處是規格,沒動。)
//   ② #today 熱門話題整段——它是導覽列四種排序之一,有自己的頁 /topics/today/,首頁不重複。
//   ③ #talking 大家正在聊整段——首頁每個 Topic 底下本來就有 Post,貼文就是「正在聊」的內容;
//      另開一區把同一批資料抽出來重排一次 = 同一批資料在同一頁出現兩次 = 階層沒分清楚。
//      對應的 PeopleTalking.astro 一併刪除。
//
// 留下的:草案 §54 第一段 Global Trending + §55「首頁必須有現在」——「現在」不是靠標語喊的,
// 是靠每一列右邊那幾則正在被討論的貼文(8H 即時 feed,sort=hot,見 TopicPosts.astro)。
//
// 首頁沒有專屬版面:它就是「全球熱門」這個排序下的看板清單,跟 /topics/{today,nearby,events}/
// 用同一支 TopicBoard、同一種列(2026-08-11 用戶指正)。
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicBoard from '../components/TopicBoard.astro';
import QuestionCard from '../components/QuestionCard.astro';
import TodayWorld from '../components/TodayWorld.astro';
import Participation from '../components/Participation.astro';
import { t } from '../lib/i18n.mjs';
import { withBase } from '../lib/paths.mjs';
import { monthDay } from '../lib/format.mjs';
import { recentTopics, topicsByHeat, countryName, questionsForDate, todayWorld } from '../lib/data.mjs';
import { isPubliclyVisible } from '../lib/topic-status.mjs';
import { seoCopy } from '../lib/seo.mjs';

// 每日世界一問(docs/briefs/daily-question.md §6.3):四個新區塊插在 #trending 之前。
// poll/guess 各自可能為 null(題庫空、或該 kind 沒有 date<=今日的題目)——為 null 時
// 整塊不渲染;guess 為 null 時 poll 也不生「#guess」錨點連結(沒有目標可跳)。
const { poll, guess } = questionsForDate(new Date());
const todayWorldCountries = todayWorld(new Date());

// 首頁 = 近期話題(2026-08-11 用戶指示):快要到的議題排前面——「像是最近要到的七夕、
// 鬼門開、普渡……等等」。排序鍵見 lib/data.mjs 的 recentTopics():各國 observed_date /
// date_range_end 離今天(UTC)還有幾天,由近到遠,長青主題全年當令算 0。
// 「熱門」的語意搬到 /topics/today/ 那一頁去了,兩頁**對調**,首頁不再是熱度排序。
const HOME_WINDOW = '24h';
const recent = recentTopics(new Date(), HOME_WINDOW);
const recentIds = new Set(recent.map((topic) => topic.topic_id));
// 近期日期不足以判斷的 Topic 仍必須留在首頁,排在日期可判斷的 Topic 後面;
// 靜態 HTML 先輸出全量,TopicBoard 的 JS 才負責首屏 10 筆與觸底分批展開。
const remaining = topicsByHeat(HOME_WINDOW).filter(
  (topic) => isPubliclyVisible(topic) && !recentIds.has(topic.topic_id)
);
const rows = [...recent, ...remaining].map((topic) => ({ topic, note: seasonNote(topic) }));

// 為什麼它是「近期」:哪一國、哪一天。這是列上的事實,不是頁首的說明文字。
function seasonNote(topic) {
  const hits = (topic.season_countries || []).slice(0, 3);
  if (hits.length === 0) return null;
  return hits
    .map((c) => {
      const when = c.date_range_end
        ? `${monthDay(c.observed_date)} – ${monthDay(c.date_range_end)}`
        : monthDay(c.observed_date);
      return `${countryName(c.country_code)} · ${when}`;
    })
    .join('　');
}
---

<BaseLayout
  title={`aeiou.now${seoCopy().titleSep}${t('home.h1')}`}
  description={t('home.intro')}
  pageType="CollectionPage"
  activeSort="global"
>
  <header class="home-intro">
    <h1>{t('home.h1')}</h1>
    <p>{t('home.intro')}</p>
  </header>

  {poll && (
    <section class="q-section">
      <QuestionCard
        question={poll}
        heading={t('q.daily_title')}
        nextHref={guess ? '#guess' : undefined}
        nextLabel={guess ? t('q.next') : undefined}
      />
    </section>
  )}

  {guess && (
    <section class="q-section">
      <QuestionCard
        question={guess}
        anchorId="guess"
        heading={t('q.guess_title')}
        nextHref={withBase('questions/')}
        nextLabel={t('q.all_questions')}
      />
    </section>
  )}

  <section class="q-section">
    <TodayWorld countries={todayWorldCountries} heading={t('q.today_world_title')} />
  </section>

  <section class="q-section">
    <Participation heading={t('q.participation_title')} />
  </section>

  <section class="board" id="trending">
    <div class="section-head">
      <h2>{t('home.recent_topics')}</h2>
      <a class="section-link" href={withBase(`rankings/${HOME_WINDOW}/`)}>
        {t('home.rankings_cta')} <span aria-hidden="true">→</span>
      </a>
    </div>

    <TopicBoard rows={rows} win={HOME_WINDOW} empty={t('common.empty')} />
  </section>
</BaseLayout>

<style>
  .q-section {
    margin-block-end: clamp(2rem, 5vw, 3rem);
  }
  .home-intro {
    max-width: 48rem;
    margin-block: clamp(1.5rem, 4vw, 3rem) clamp(2rem, 5vw, 3rem);
    padding-inline-start: clamp(0.75rem, 2vw, 1.25rem);
    border-inline-start: 0.25rem solid var(--color-accent);
  }
  .home-intro h1 {
    margin: 0 0 0.65rem;
  }
  .home-intro p {
    margin: 0;
    color: var(--color-ink-soft);
    line-height: 1.6;
  }
  .board {
    margin-block-end: clamp(2.5rem, 6vw, 4rem);
    scroll-margin-block-start: 1rem;
  }
  .section-link {
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-accent-dark);
    font-weight: 600;
    white-space: nowrap;
  }
  .section-link:hover {
    text-decoration: underline;
  }
</style>
