---
// Topic 清單的排序頁。三個網址(today / nearby / events)＋首頁(global)= 導覽列的四項,
// 四頁共用同一支 TopicBoard,差別只在排序/篩選與空狀態文案。
//
// 「長相一致」是硬要求(2026-08-11 用戶指正):這三頁不是光禿禿的 Topic 標題列,
// 每一列跟首頁一樣是左欄主題介紹 + 右欄該 Topic 最高的三篇(見 TopicRow / TopicPosts)。
// nearby / events 只讀本語系站的代表城市；頁面不把七個市場的資料混在一起。
//
// 用戶原話:「全球熱門、熱門話題、附近訊息、活動資訊……這些其實都是 Topic 的排序。」
// 所以這三頁列出來的一律是 **Topic**:
//   · today  熱門話題 = 依熱度(topics index 的 scores['24h'])由高到低的 Topic
//            (2026-08-11 用戶指示:「/topics/today/ 的 h1 才是『🔥熱門話題』」——
//             首頁與這一頁的語意對調了,首頁是近期/當令,這一頁是熱門)
//   · nearby 附近訊息 = 本語系代表城市的全部 Topic;有地點的排前面,沒有的保留在後面
//   · events 活動資訊 = 本語系代表城市的全部 Topic;有活動的排前面,沒有的保留在後面
// 店家與活動本身不在這裡列——它們屬於各自的 Topic 頁(草案 §44 的 📍 Near You / 🎉 Events)。
//
// 頁首只有 <h1>(2026-08-11 用戶指示):眉標「議題排序」與所有說明段落整批刪除,
// 「你多個『議題排序』要幹嘛?浪費空間!」不知道讀者在哪裡也不要寫成一句給讀者看的自白。
//
// nearby / events 的排序只在這個代表城市的全部 Topic 之間進行；
// 以 GET /v1/reactions/summary 取得 emoji 總數後在同一城市內重排。
// 任何 fetch 失敗 → 維持靜態順序,不清空、不顯示錯誤(見頁尾 script)。
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicBoard from '../../components/TopicBoard.astro';
import { t } from '../../lib/i18n.mjs';
import { sortLabel } from '../../lib/nav.mjs';
import { dateTime } from '../../lib/format.mjs';
import { LOCALE, MARKET_CITY } from '../../lib/config.mjs';
import { siteDescription, SITE_OVERVIEW_IMAGE_PATH } from '../../lib/seo.mjs';
import { withBase } from '../../lib/paths.mjs';
import {
  topicsByHeat, topicsWithPlacesByCity, topicsWithEventsByCity, cityName, coverPath,
} from '../../lib/data.mjs';

export function getStaticPaths() {
  return [
    { params: { sort: 'today' } },
    { params: { sort: 'nearby' } },
    { params: { sort: 'events' } },
  ];
}

const { sort } = Astro.params;
const HEAT_WINDOW = '24h';
const marketCity = MARKET_CITY[LOCALE] || null;

let groups = [];
let empty = '';
let sortConfig = null;

if (sort === 'today') {
  empty = t('sort.hot_empty');
  groups = [
    {
      city_code: null,
      rows: topicsByHeat(HEAT_WINDOW).map((topic) => ({ topic })),
    },
  ];
} else {
  const isNearby = sort === 'nearby';
  empty = isNearby ? t('sort.nearby_empty') : t('sort.events_empty');
  const cities = isNearby
    ? topicsWithPlacesByCity(marketCity)
    : topicsWithEventsByCity(marketCity);
  groups = cities.map((city) => ({
    city_code: city.city_code,
    rows: city.topics.map((topic) => ({
      topic,
      tags: [
        isNearby
          ? { label: t('sort.places_label'), value: topic.place_count }
          : { label: t('sort.events_label'), value: topic.event_count },
      ],
      note: !isNearby && topic.next_start_at ? dateTime(topic.next_start_at) : null,
    })),
  }));
  sortConfig = {
    api: import.meta.env.PUBLIC_API_URL || '',
    targetType: isNearby ? 'place' : 'event',
    groups: cities.map((city) => ({
      city: city.city_code,
      country: city.country_code || null,
      topics: city.topics.map((topic) => ({
        id: topic.topic_id,
        targets: topic.target_ids || [],
      })),
    })),
  };
}

const total = groups.reduce((n, group) => n + group.rows.length, 0);
const label = sortLabel(sort);
const emoji = { today: '🔥', nearby: '📍', events: '🎉' }[sort];
const representativeTopic = groups
  .flatMap((group) => group.rows)
  .map((row) => row.topic)
  .find((topic) => coverPath(topic?.slug));
const representativeCover = representativeTopic ? coverPath(representativeTopic.slug) : null;
// </script> 防拆:JSON 內任何 "<" 都轉義
const sortConfigJson = sortConfig
  ? JSON.stringify(sortConfig).replace(/</g, '\\u003c')
  : null;
---

<BaseLayout
  title={`${label} — aeiou.now`}
  description={`${label} · ${siteDescription()}`}
  pageType="CollectionPage"
  activeSort={sort}
  image={withBase(representativeCover || SITE_OVERVIEW_IMAGE_PATH)}
  imageAlt={representativeTopic?.title || label}
>
  <header class="sort-head">
    <h1><span class="sort-emoji" aria-hidden="true">{emoji}</span>{label}</h1>
  </header>

  {total === 0 && <p class="sort-empty">{empty}</p>}

  {sortConfigJson && (
    <script type="application/json" data-sort-config set:html={sortConfigJson} />
  )}

  <div data-sort-groups>
    {groups.map((group) =>
      group.rows.length === 0 ? null : (
        <section class="sort-group" data-city={group.city_code || undefined}>
          {group.city_code && (
            <h2 class="sort-city">
              <span class="sort-city-label">{t('sort.city_label')}</span>
              {cityName(group.city_code)}
            </h2>
          )}
          <TopicBoard rows={group.rows} empty={empty} />
        </section>
      )
    )}
  </div>
</BaseLayout>

<script>
  // 附近訊息 / 活動資訊的用戶端重排(today 頁沒有 [data-sort-config],這一段整個不跑)。
  //
  // 排序鍵(由高到低):
  //   ① 本語系代表城市只有一組,不做跨城市搬移。
  //   ② 該 Topic 底下 places/events 的 reaction 總數,高的在前。
  //   ③ 再同分就照靜態順序,結果才穩定。
  //
  // 降級:fetch 拿不到東西就原地不動——維持靜態順序,不清空、不顯示錯誤文字。
  const cfgNode = document.querySelector('[data-sort-config]');
  const container = document.querySelector('[data-sort-groups]');
  let cfg = null;
  try {
    cfg = cfgNode ? JSON.parse(cfgNode.textContent) : null;
  } catch {
    cfg = null; // 設定壞掉就不重排,靜態順序本來就是可用的
  }

  if (cfg && cfg.api && container) {
    const ids = [];
    cfg.groups.forEach((group) => {
      (group.topics || []).forEach((topic) => {
        (topic.targets || []).forEach((id) => {
          if (id && ids.indexOf(id) < 0 && ids.length < 100) ids.push(id); // 契約:一次最多 100 個 id
        });
      });
    });

    const ok = (res) => (res.ok ? res.json() : null);
    const summary = ids.length
      ? fetch(
          cfg.api +
            '/v1/reactions/summary?target_type=' +
            encodeURIComponent(cfg.targetType) +
            '&ids=' +
            ids.map(encodeURIComponent).join(','),
          { credentials: 'include' }
        )
          .then(ok)
          .catch(() => null)
      : Promise.resolve(null);

    summary.then((sums) => {
      if (!sums) return; // 請求掛掉 → 靜態順序原樣留著
      const items = (sums && sums.items) || {};
      const emojiTotal = (targets) => {
        let n = 0;
        (targets || []).forEach((id) => {
          const hit = items[id];
          if (!hit || !hit.reactions) return;
          Object.keys(hit.reactions).forEach((kind) => {
            const v = hit.reactions[kind];
            if (typeof v === 'number') n += v;
          });
        });
        return n;
      };

      const ranked = cfg.groups.map((group, i) => {
        const topics = (group.topics || []).map((topic, j) => ({
          id: topic.id,
          emoji: emojiTotal(topic.targets),
          i: j,
        }));
        return {
          city: group.city,
          emoji: topics.reduce((n, topic) => n + topic.emoji, 0),
          i: i,
          topics: topics.sort((a, b) => b.emoji - a.emoji || a.i - b.i),
        };
      });
      ranked.sort((a, b) => b.emoji - a.emoji || a.i - b.i);

      const sections = new Map();
      container.querySelectorAll('[data-city]').forEach((node) => {
        sections.set(node.dataset.city, node);
      });
      ranked.forEach((group) => {
        const section = sections.get(group.city);
        if (!section) return;
        container.appendChild(section); // appendChild 會搬移既有節點,不重建、不清空
        const list = section.querySelector('.board-list');
        if (!list) return;
        // 只認 <ol> 的直屬 <li>:貼文容器也帶 data-topic-id(同一個 id),用 querySelector
        // 會挑到誰要看 DOM 順序,太脆。
        const rows = new Map();
        Array.prototype.forEach.call(list.children, (node) => {
          if (node.dataset && node.dataset.topicId) rows.set(node.dataset.topicId, node);
        });
        group.topics.forEach((topic) => {
          const row = rows.get(topic.id);
          if (row) list.appendChild(row);
        });
        document.dispatchEvent(new CustomEvent('aeiou:topic-order-updated'));
      });
    });
  }
</script>

<style>
  .sort-head {
    padding-block-end: 1.25rem;
    margin-block-end: clamp(1.5rem, 4vw, 2.5rem);
    border-block-end: 0.0625rem solid var(--color-line);
  }
  .sort-head h1 {
    margin: 0.5rem 0 0;
  }
  .sort-emoji {
    margin-inline-end: 0.4rem;
  }
  .sort-empty {
    color: var(--color-ink-muted);
    max-width: 42rem;
  }
  .sort-group {
    margin-block-end: clamp(2rem, 5vw, 3rem);
  }
  .sort-city {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    font-size: var(--text-lg);
    margin: 0 0 0.5rem;
    color: var(--color-primary);
  }
  .sort-city-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
</style>
