---
// 熱度級距(PTT「爆」式):只呈現量級,不印原始分數。
// - 級距定義集中在 src/lib/heat.mjs,三個頁面共用同一支,模板不各自算門檻。
// - 不只靠顏色:同時給「填滿幾格」的長度差異 + 文字標籤(色盲/灰階列印仍可讀),
//   最高階再多一層形狀差異(反白實心 chip),對應 PTT 的「爆」。
import { heatTier, heatLabelKey, HEAT_LEVELS } from '../lib/heat.mjs';
import { t } from '../lib/i18n.mjs';

interface Props {
  score?: number;
  size?: 'sm' | 'md';
  caption?: string; // 前綴說明(如時窗名),沒有就不畫
}
const { score, size = 'sm', caption } = Astro.props;
const tier = heatTier(score);
const label = t(heatLabelKey(tier.id));
const cells = Array.from({ length: HEAT_LEVELS }, (_, i) => i < tier.level);
---

<span class="heat" data-tier={tier.id} data-size={size}>
  {caption && <span class="heat-caption">{caption}</span>}
  <span class="heat-bars" aria-hidden="true">
    {cells.map((on) => <span class:list={['heat-bar', { on }]} />)}
  </span>
  <span class="heat-label">{label}</span>
</span>

<style>
  .heat {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-xs);
    line-height: 1.3;
  }
  .heat[data-size='md'] {
    font-size: var(--text-sm);
  }
  .heat-caption {
    color: var(--color-ink-muted);
  }
  .heat-bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.14em;
    height: 1.1em;
  }
  .heat-bar {
    width: 0.3em;
    background: var(--color-heat-track);
    border-radius: var(--radius-sm);
  }
  /* 階梯狀高度:格數與高度雙重編碼,不依賴顏色也讀得出強弱 */
  .heat-bar:nth-child(1) { height: 0.4em; }
  .heat-bar:nth-child(2) { height: 0.575em; }
  .heat-bar:nth-child(3) { height: 0.75em; }
  .heat-bar:nth-child(4) { height: 0.925em; }
  .heat-bar:nth-child(5) { height: 1.1em; }

  .heat[data-tier='quiet'] .heat-bar.on { background: var(--color-heat-quiet); }
  .heat[data-tier='warm'] .heat-bar.on { background: var(--color-heat-warm); }
  .heat[data-tier='rising'] .heat-bar.on { background: var(--color-heat-rising); }
  .heat[data-tier='hot'] .heat-bar.on { background: var(--color-heat-hot); }
  .heat[data-tier='blast'] .heat-bar.on { background: var(--color-heat-blast); }

  .heat-label {
    font-weight: 700;
    color: var(--color-ink-soft);
    white-space: nowrap;
    letter-spacing: 0.02em;
  }
  .heat[data-tier='hot'] .heat-label {
    color: var(--color-accent-dark);
  }
  /* 最高階 = 反白實心,形狀本身就不一樣(對應 PTT 的「爆」) */
  .heat[data-tier='blast'] .heat-label {
    background: var(--color-heat-blast);
    color: var(--color-white);
    padding: 0.05em 0.6em;
    border-radius: var(--radius-sm);
  }
</style>
