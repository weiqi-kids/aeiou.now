---
// 熱度級距(PTT「爆」式):只呈現量級,不印原始分數。
// - 級距定義集中在 src/lib/heat.mjs,三個頁面共用同一支,模板不各自算門檻。
// - 不只靠顏色:同時給「填滿幾格」的長度差異 + 文字標籤(色盲/灰階列印仍可讀),
//   最高階再多一層形狀差異(反白實心 chip),對應 PTT 的「爆」。
import { HEAT_TIERS, heatTier, heatLabelKey, HEAT_LEVELS } from '../lib/heat.mjs';
import { t } from '../lib/i18n.mjs';

interface Props {
  tier?: string;    // 級距 id(data/ 直接給,見 scripts/export-data.mjs 的說明)
  score?: number;   // 相容用:仍可傳原始分數,由本元件換算
  size?: 'sm' | 'md';
  caption?: string; // 前綴說明(如時窗名),沒有就不畫
}
// 2026-08-20:資料層改成直接給 tier(離散),分數不再進 data/。
// 原因是分數含時間項、每天漂移,會讓靜態產物天天重寫、七站天天重建,
// 但畫面只用得到五個級距之一,重建換來零變化。仍保留 score 這條路,
// 讓「手上只有分數」的呼叫端(例如未來的即時層)不必先自己換算。
const { tier: tierId, score, size = 'sm', caption } = Astro.props;
const tier = tierId
  ? (HEAT_TIERS.find((x) => x.id === tierId) || heatTier(0))
  : heatTier(score);
const label = t(heatLabelKey(tier.id));
const cells = Array.from({ length: HEAT_LEVELS }, (_, i) => i < tier.level);

// 階梯條改成「一個元素、N 層背景」而不是「N 個 <span>」(2026-08-22)。
// 理由:整段是 aria-hidden 的純裝飾,但在清單頁它是每張卡都乘一次的固定成本
// (卡數 × HEAT_LEVELS 個盒子要排版)。畫面編碼不變 —— 格數與階梯高度仍然雙重編碼,
// 加上外面的文字標籤,不依賴顏色也讀得出強弱。
// **幾何值在這裡算,不寫死進 CSS** —— HEAT_LEVELS 來自 HEAT_TIERS.length,
// 級距數一改,CSS 若寫死就會默默畫錯。
const BAR_W = 0.3;      // 每根寬(em)
const BAR_GAP = 0.14;   // 根與根的間距(em)
const BAR_MIN = 0.4;    // 最矮那根(em)
const BAR_MAX = 1.1;    // 最高那根(em)
const barStep = HEAT_LEVELS > 1 ? (BAR_MAX - BAR_MIN) / (HEAT_LEVELS - 1) : 0;
const fill = (on: boolean) => (on ? 'var(--heat-fill)' : 'var(--color-heat-track)');
const barsStyle = [
  `--heat-bars-w:${(HEAT_LEVELS * BAR_W + (HEAT_LEVELS - 1) * BAR_GAP).toFixed(3)}em`,
  `--heat-bars-h:${BAR_MAX}em`,
  `background-image:${cells.map((on) => `linear-gradient(${fill(on)},${fill(on)})`).join(',')}`,
  `background-size:${cells.map((_, i) => `${BAR_W}em ${(BAR_MIN + i * barStep).toFixed(3)}em`).join(',')}`,
  `background-position:${cells.map((_, i) => `${(i * (BAR_W + BAR_GAP)).toFixed(3)}em 100%`).join(',')}`,
].join(';');
---

<span class="heat" data-tier={tier.id} data-size={size}>
  {caption && <span class="heat-caption">{caption}</span>}
  <span class="heat-bars" aria-hidden="true" style={barsStyle} />
  <span class="heat-label">{label}</span>
</span>

<style>
  .heat {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-xs);
    line-height: 1.3;
  }
  .heat[data-size='md'] {
    font-size: var(--text-sm);
  }
  .heat-caption {
    color: var(--color-ink-muted);
  }
  /* 幾何(寬/高/每根的位置與高度)由 frontmatter 以 inline style 給,見上面的說明。
     這裡只留不隨級距變的部分,以及「填滿的那幾根用什麼顏色」。 */
  .heat-bars {
    display: inline-block;
    inline-size: var(--heat-bars-w);
    block-size: var(--heat-bars-h);
    background-repeat: no-repeat;
  }
  .heat[data-tier='quiet'] .heat-bars { --heat-fill: var(--color-heat-quiet); }
  .heat[data-tier='warm'] .heat-bars { --heat-fill: var(--color-heat-warm); }
  .heat[data-tier='rising'] .heat-bars { --heat-fill: var(--color-heat-rising); }
  .heat[data-tier='hot'] .heat-bars { --heat-fill: var(--color-heat-hot); }
  .heat[data-tier='blast'] .heat-bars { --heat-fill: var(--color-heat-blast); }

  .heat-label {
    font-weight: 700;
    color: var(--color-ink-soft);
    white-space: nowrap;
    letter-spacing: 0.02em;
  }
  .heat[data-tier='hot'] .heat-label {
    color: var(--color-accent-dark);
  }
  /* 最高階 = 反白實心,形狀本身就不一樣(對應 PTT 的「爆」) */
  .heat[data-tier='blast'] .heat-label {
    background: var(--color-heat-blast);
    color: var(--color-white);
    padding: 0.05em 0.6em;
    border-radius: var(--radius-sm);
  }
</style>
