---
// 討論串本體(草案 §44 的「💬 People Are Talking About」)。
// 這不是文章底下的留言區,而是主題頁存在的理由,所以它是整頁最大的一塊:
// 發文框 → 貼文列表 → 每則貼文的七顆 emoji 列 → 留言 → 回覆框。
//
// 降級模型(不可動的行為):
// - 靜態 HTML 預設渲染 fallback(room.closed),容器帶 data-room-state="closed"
// - JS fetch 成功且解析出 posts 陣列 → data-room-state="open",才替換為即時內容
// - 任何失敗(網路、非 2xx、JSON 壞掉)一律保持/退回 closed;PUBLIC_API_URL 未設時完全不發 fetch
// - 不做 fallback 快照、不顯示過期資料
// - 貼文與留言 M1 一律純文字轉義顯示(textContent),絕不 innerHTML 塞使用者內容
//
// 四態(2026-08-11 用戶指正:正常載入時會先閃一下「討論室暫時關閉」,
// 那是把「還沒開始載入」與「載入失敗」混用同一個狀態):
//
//   closed  ← 靜態預設值。沒有 JS、fetch 失敗、非 2xx、JSON 壞掉、PUBLIC_API_URL 未設
//   loading ← JS 一啟動(發 fetch 之前)就切,還沒拿到回應
//   open + 空     ← fetch 成功但 posts 為 0 筆
//   open + 有內容 ← fetch 成功且有貼文
//
// 靜態 HTML 仍然預設 closed 且直接渲染關閉文案(沒有 JS 的讀者要看到「暫時關閉」而不是空白框,
// curl 驗降級也是靠 grep data-room-state="closed"),loading 只由 JS 切,所以兩者不衝突。
//
// 成功開室後會發 aeiou:room-open 事件(detail: {topicId, posts}),讓同頁的 8H 時窗共用
// 這一次 fetch 的結果——同一份資料不打第二次 API。
//
// 七顆 emoji 的按鈕行為在 src/lib/reactions.mjs(與看板列 TopicPosts 共用同一份)。
// ⚠ 該檔檔頭記著一條 M1 契約限制:feed(api-contract §1)不回 mine,所以載入時所有 emoji
// 一律是未按狀態,按下去拿到 POST /v1/reactions 的 mine 之後才知道自己按過哪些。
// 那是契約缺口,不是 bug;要修得先改契約 §1,M1 不動 Worker。
import { t } from '../lib/i18n.mjs';
import { LOCALE, REACTION_SET } from '../lib/config.mjs';

interface Props {
  topicId: string; // API 路徑參數是 topic_id(ULID),不是 slug
}
const { topicId } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL || '';

const roomConfig = {
  locale: LOCALE,
  reactions: REACTION_SET,
  i18n: {
    empty: t('room.empty'),
    composePlaceholder: t('room.compose_placeholder'),
    submit: t('room.submit'),
    commentPlaceholder: t('room.comment_placeholder'),
    commentSubmit: t('room.comment_submit'),
    commentsExpand: t('room.comments_expand'),
    commentsCollapse: t('room.comments_collapse'),
    commentsMore: t('room.comments_more'),
    translating: t('post.translating'),
    showOriginal: t('post.show_original'),
    hideOriginal: t('post.hide_original'),
    error: t('common.error'),
    reactionLabel: t('reaction.label'),
    reactionFailed: t('reaction.failed'),
  },
};
// </script> 防拆:JSON 內任何 "<" 都轉義,靜態字串也照做(衛生習慣)
const roomConfigJson = JSON.stringify(roomConfig).replace(/</g, '\\u003c');
---

<div
  class="room"
  data-room
  data-room-state="closed"
  data-topic-id={topicId}
  data-api-url={apiUrl}
>
  <script type="application/json" data-room-config set:html={roomConfigJson} />
  <div class="room-fallback">
    <p class="room-closed-title">{t('room.closed')}</p>
    <p class="room-closed-hint">{t('room.closed_hint')}</p>
  </div>
  <!-- 載入中:靜態渲染但預設 hidden,JS 一啟動就換上來。骨架條純裝飾(aria-hidden),
       要唸的字在上面那一行 role="status"。 -->
  <div class="room-loading" hidden>
    <p class="room-loading-text" role="status">{t('room.loading')}</p>
    <div class="room-skeleton" aria-hidden="true">
      <span class="room-skeleton-bar"></span>
      <span class="room-skeleton-bar"></span>
      <span class="room-skeleton-bar"></span>
    </div>
  </div>
  <div class="room-live" hidden></div>
</div>

<script>
  import { createReactions } from '../lib/reactions.mjs';

  const COMMENT_PREVIEW = 2; // 每則貼文預設露出的留言數,其餘收在展開控制項底下

  // 四態切換集中在這一支,免得各處各自 hidden 一半——正常載入會閃「討論室暫時關閉」
  // 就是因為「還沒開始載入」沒有自己的狀態,只好借用 closed 的畫面。
  function setRoomState(root, state) {
    const fallback = root.querySelector('.room-fallback');
    const loading = root.querySelector('.room-loading');
    const live = root.querySelector('.room-live');
    if (fallback) fallback.hidden = state !== 'closed';
    if (loading) loading.hidden = state !== 'loading';
    if (live) live.hidden = state !== 'open';
    root.dataset.roomState = state;
  }

  // i18n 樣板填值:{count} / {total} / {shown}。模板不寫死任何語言的字。
  function fill(template, values) {
    return String(template).replace(/\{(\w+)\}/g, (whole, key) =>
      Object.prototype.hasOwnProperty.call(values, key) ? String(values[key]) : whole
    );
  }

  // 原生 script(無框架)。開狀態的 DOM 全用 createElement/textContent 組——不進 innerHTML。
  function initRoom(root) {
    const api = root.dataset.apiUrl;
    const topicId = root.dataset.topicId;
    if (!api || !topicId) return; // PUBLIC_API_URL 未設:完全不發 fetch,不切 loading,永遠 closed

    let cfg;
    try {
      cfg = JSON.parse(root.querySelector('[data-room-config]').textContent);
    } catch {
      return; // 設定壞掉一律保持 closed
    }

    // 發 fetch **之前**就切 loading:等回應才切的話,這段空窗期畫面上是關閉文案,
    // 每一次正常載入都會先閃一下「討論室暫時關閉」。
    setRoomState(root, 'loading');

    const feedUrl = api + '/v1/topics/' + topicId + '/feed?sort=hot&limit=20&comments=3';
    fetch(feedUrl, { credentials: 'include' })
      .then((res) => {
        if (!res.ok) throw new Error('http ' + res.status);
        return res.json();
      })
      .then((data) => {
        if (!data || !Array.isArray(data.posts)) throw new Error('bad shape');
        openRoom(root, cfg, topicId, api, data.posts);
        document.dispatchEvent(
          new CustomEvent('aeiou:room-open', { detail: { topicId: topicId, posts: data.posts } })
        );
      })
      .catch(() => {
        // 任何失敗退回 closed(不是停在 loading),不顯示過期資料、不做 fallback 快照
        setRoomState(root, 'closed');
      });
  }

  function el(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text; // 使用者內容只走 textContent
    return node;
  }

  function pickText(post, locale) {
    if (post.original_locale === locale) {
      return { text: post.content, showToggle: false, pending: false };
    }
    const tr = post.translations && post.translations[locale];
    if (tr) return { text: tr, showToggle: true, pending: false };
    return { text: post.content, showToggle: false, pending: true }; // 缺譯:原文 + 翻譯中
  }

  function fmtTime(epochSec, locale) {
    try {
      return new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeStyle: 'short' })
        .format(new Date(epochSec * 1000));
    } catch {
      return new Date(epochSec * 1000).toISOString();
    }
  }

  // 七顆 emoji 的按鈕列。行為(op 切換、失敗還原、連點防護、aria-pressed)全在
  // src/lib/reactions.mjs,與看板列的 TopicPosts 共用同一份——同一顆 emoji 在兩處不能有兩種行為。
  function renderReactionBar(post, cfg, api) {
    const bar = el('div', 'room-reactions');
    const reactions = createReactions({
      targetType: 'post',
      targetId: post.post_id,
      emojis: cfg.reactions,
      counts: post.reactions,
      api: api,
      i18n: { label: cfg.i18n.reactionLabel, failed: cfg.i18n.reactionFailed },
      classes: {
        btn: 'room-reaction-btn',
        emoji: 'room-reaction-emoji',
        count: 'room-reaction-count',
        status: 'room-reaction-status',
        mine: 'is-mine',
        error: 'is-error',
      },
    });
    reactions.nodes.forEach((node) => bar.appendChild(node));
    return bar;
  }

  function renderComment(comment, cfg) {
    const row = el('p', 'room-comment');
    const who = [comment.country_code, comment.city_code].filter(Boolean).join(' · ');
    row.appendChild(el('span', 'room-comment-meta', who ? who + ' — ' : ''));
    row.appendChild(document.createTextNode(comment.content)); // 留言不翻譯,純文字
    return row;
  }

  // 收合中的留言串(用戶 2026-08-11 指正:一則貼文的留言全部攤開,貼文一多就讀不下去)。
  //   · 預設只露 COMMENT_PREVIEW 則,其餘 hidden
  //   · 展開控制項是真的 <button>(鍵盤可操作)+ aria-expanded,可以來回切換
  //   · **實際超過** COMMENT_PREVIEW 則才出現,標示還有幾則
  //   · 自己剛送出的留言不該被收進摺疊裡(送出後看不到 = 像沒送出去),所以送出即展開
  let commentListSeq = 0;
  function createCommentList(post, cfg) {
    const list = el('div', 'room-comment-list');
    list.id = 'room-comment-list-' + ++commentListSeq; // aria-controls 要指得到
    const toggle = el('button', 'room-comments-toggle');
    toggle.type = 'button';
    toggle.setAttribute('aria-controls', list.id);
    let expanded = false;

    function sync() {
      const rows = Array.prototype.slice.call(list.children);
      rows.forEach((row, i) => {
        row.hidden = !expanded && i >= COMMENT_PREVIEW;
      });
      const rest = Math.max(0, rows.length - COMMENT_PREVIEW);
      toggle.hidden = rest === 0; // 沒有多的就不出現控制項
      toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      toggle.textContent = expanded
        ? cfg.i18n.commentsCollapse
        : fill(cfg.i18n.commentsExpand, { count: rest });
    }

    toggle.addEventListener('click', () => {
      expanded = !expanded;
      sync();
    });

    if (Array.isArray(post.comments)) {
      post.comments.forEach((c) => list.appendChild(renderComment(c, cfg)));
    }
    sync();

    return {
      list: list,
      toggle: toggle,
      append: function (comment) {
        list.appendChild(renderComment(comment, cfg));
        expanded = true;
        sync();
      },
    };
  }

  // 每則貼文自己的回覆框(契約 §3 POST /v1/comments;沒有新端點)
  function renderCommentForm(post, cfg, api, comments, counter) {
    const form = el('form', 'room-comment-form');
    const box = el('input', 'room-comment-input');
    box.type = 'text';
    box.required = true;
    box.maxLength = 2000;
    box.placeholder = cfg.i18n.commentPlaceholder;
    const send = el('button', 'room-comment-submit', cfg.i18n.commentSubmit);
    send.type = 'submit';
    form.append(box, send);
    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const content = box.value.trim();
      if (!content) return;
      send.disabled = true;
      fetch(api + '/v1/comments', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ post_id: post.post_id, content: content, locale: cfg.locale }),
      })
        .then((res) => {
          if (!res.ok) throw new Error('http ' + res.status);
          return res.json();
        })
        .then((comment) => {
          if (!comment || !comment.comment_id) throw new Error('bad shape');
          comments.append(comment);
          if (counter && typeof comment.comment_count === 'number') {
            counter.textContent = String(comment.comment_count);
          }
          box.value = '';
        })
        .catch(() => {})
        .finally(() => {
          send.disabled = false;
        });
    });
    return form;
  }

  function renderPost(post, cfg, api) {
    const item = el('article', 'room-post');
    const meta = el('p', 'room-post-meta');
    const origin = [post.country_code, post.city_code].filter(Boolean).join(' · ');
    meta.textContent = origin
      ? origin + ' · ' + fmtTime(post.created_at, cfg.locale)
      : fmtTime(post.created_at, cfg.locale);
    item.appendChild(meta);

    const picked = pickText(post, cfg.locale);
    item.appendChild(el('p', 'room-post-content', picked.text));
    if (picked.pending) {
      item.appendChild(el('p', 'room-post-note', cfg.i18n.translating));
    }
    if (picked.showToggle) {
      const orig = el('p', 'room-post-original', post.content);
      orig.hidden = true;
      const toggle = el('button', 'room-toggle', cfg.i18n.showOriginal);
      toggle.type = 'button';
      toggle.addEventListener('click', () => {
        orig.hidden = !orig.hidden;
        toggle.textContent = orig.hidden ? cfg.i18n.showOriginal : cfg.i18n.hideOriginal;
      });
      item.append(toggle, orig);
    }

    item.appendChild(renderReactionBar(post, cfg, api));

    const thread = el('div', 'room-comments');
    const head = el('p', 'room-comments-head');
    head.appendChild(el('span', 'room-comments-icon', '💬'));
    const counter = el('span', 'room-comments-count', String(post.comment_count || 0));
    head.appendChild(counter);
    thread.appendChild(head);

    const comments = createCommentList(post, cfg);
    thread.appendChild(comments.list);
    thread.appendChild(comments.toggle);

    // 契約 §1 硬規定 3:comments 陣列是**最新 N 則**,comment_count 是**總數**,兩者不可互推。
    // 總數比手上多的時候要講實話——展開只展得開手上這幾則,剩下的這一輪根本沒拿到。
    const loaded = Array.isArray(post.comments) ? post.comments.length : 0;
    const total = typeof post.comment_count === 'number' ? post.comment_count : loaded;
    if (total > loaded) {
      thread.appendChild(
        el('p', 'room-comments-note', fill(cfg.i18n.commentsMore, { total: total, shown: loaded }))
      );
    }

    thread.appendChild(renderCommentForm(post, cfg, api, comments, counter));
    item.appendChild(thread);

    return item;
  }

  function renderComposer(cfg, topicId, api, feedList) {
    const form = el('form', 'room-composer');
    const box = el('textarea', 'room-composer-input');
    box.placeholder = cfg.i18n.composePlaceholder;
    box.required = true;
    box.maxLength = 5000;
    const send = el('button', 'room-composer-submit', cfg.i18n.submit);
    send.type = 'submit';
    const err = el('p', 'room-composer-error');
    err.hidden = true;
    form.append(box, send, err);
    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const content = box.value.trim();
      if (!content) return;
      err.hidden = true;
      send.disabled = true;
      fetch(api + '/v1/posts', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ topic_id: topicId, content: content, locale: cfg.locale }),
      })
        .then((res) => {
          if (!res.ok) throw new Error('http ' + res.status);
          return res.json();
        })
        .then((post) => {
          if (!post || !post.post_id) throw new Error('bad shape');
          const emptyNote = feedList.querySelector('.room-empty');
          if (emptyNote) emptyNote.remove();
          feedList.prepend(renderPost(post, cfg, api));
          box.value = '';
        })
        .catch(() => {
          err.textContent = cfg.i18n.error;
          err.hidden = false;
        })
        .finally(() => {
          send.disabled = false;
        });
    });
    return form;
  }

  function openRoom(root, cfg, topicId, api, posts) {
    const live = root.querySelector('.room-live');
    const fallback = root.querySelector('.room-fallback');
    if (!live || !fallback) return;
    live.textContent = '';

    const feedList = el('div', 'room-feed');
    if (posts.length === 0) {
      feedList.appendChild(el('p', 'room-empty', cfg.i18n.empty));
    } else {
      posts.forEach((p) => feedList.appendChild(renderPost(p, cfg, api)));
    }
    live.appendChild(renderComposer(cfg, topicId, api, feedList));
    live.appendChild(feedList);

    setRoomState(root, 'open'); // 成功解析 posts 陣列後才切 open(空也是 open)
  }

  document.querySelectorAll('[data-room]').forEach(initRoom);
</script>

<style>
  /* 討論串是主題頁的主體,不是附屬面板:白底大面積 + 主色上緣,關閉時退成安靜的告示。 */
  .room {
    border: 0.0625rem solid var(--color-line);
    border-block-start: 0.25rem solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: clamp(1.25rem, 4vw, 2.5rem);
    background: var(--color-white);
    box-shadow: var(--shadow-card);
  }
  /* 關閉狀態刻意做成「安靜的告示」而不是錯誤警告:降級不是故障。
     但版位要留著——討論串是這一頁的主體,關閉時也不該縮成一條細線。 */
  .room[data-room-state='closed'] {
    border-block-start-color: var(--color-line-strong);
    background: var(--color-bg-light);
    box-shadow: none;
    min-block-size: 10rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .room-closed-title {
    margin: 0 0 0.25rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-ink-soft);
  }
  .room-closed-hint {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  /* 載入中:版位與關閉狀態一樣高,狀態切換時版面不跳。這一態刻意不長得像錯誤——
     它是「還沒回來」,不是「壞掉」。 */
  .room[data-room-state='loading'] {
    min-block-size: 10rem;
  }
  .room-loading-text {
    margin: 0 0 0.75rem;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .room-skeleton {
    display: grid;
    gap: 0.5rem;
    max-inline-size: 34rem;
  }
  .room-skeleton-bar {
    display: block;
    block-size: 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-line);
    animation: room-skeleton-pulse 1.4s ease-in-out infinite;
  }
  .room-skeleton-bar:nth-child(2) {
    inline-size: 84%;
    animation-delay: 0.15s;
  }
  .room-skeleton-bar:nth-child(3) {
    inline-size: 62%;
    animation-delay: 0.3s;
  }
  @keyframes room-skeleton-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .room-skeleton-bar {
      animation: none;
    }
  }
  .room :global(.room-composer) {
    display: grid;
    gap: 0.5rem;
    margin-block-end: 2rem;
  }
  .room :global(.room-composer-input) {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    padding: 0.625rem 0.875rem;
    border: 0.0625rem solid var(--color-line-strong);
    border-radius: var(--radius-md);
    min-height: 6rem;
  }
  .room :global(.room-composer-submit) {
    justify-self: end;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    padding: 0.4rem 1.75rem;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-white);
    cursor: pointer;
  }
  .room :global(.room-composer-error) {
    margin: 0;
    color: var(--color-accent-dark);
    font-size: var(--text-sm);
  }
  .room :global(.room-post) {
    background: var(--color-bg-light);
    border: 0.0625rem solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-block-end: 1.25rem;
  }
  .room :global(.room-post-meta),
  .room :global(.room-comment-meta) {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    margin: 0 0 0.25rem;
  }
  .room :global(.room-post-content) {
    margin: 0 0 0.5rem;
    white-space: pre-wrap;
  }
  .room :global(.room-post-note) {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    margin: 0 0 0.5rem;
  }
  .room :global(.room-post-original) {
    color: var(--color-ink-soft);
    border-inline-start: 0.1875rem solid var(--color-line);
    padding-inline-start: 0.75rem;
    margin: 0.5rem 0;
    white-space: pre-wrap;
  }
  .room :global(.room-toggle) {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    background: none;
    border: 0;
    color: var(--color-primary);
    cursor: pointer;
    padding: 0;
  }
  .room :global(.room-reactions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin-block: 0.75rem;
  }
  .room :global(.room-reaction-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
