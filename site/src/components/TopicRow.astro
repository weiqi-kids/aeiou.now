---
// 看板列(草案 §54 前台首頁的基本單位;四個排序頁共用同一種長相)。
// 這不是雜誌封面而是看板列表,所以一則議題 = 一列,不是一張大卡。
//
// 一列分左右兩欄(2026-08-11 用戶指正的版面):
//
//   ┌──────────────────────────────┬────────────────────┐
//   │ 1  問世界                     │ 貼文 1              │
//   │    [社群][長青主題]            │ 貼文 2              │
//   │    對其他國家的日常感到好奇?…   │ 貼文 3              │
//   │                 24小時 ▮▮▮ 高熱│                    │
//   │        ← 左:主題介紹           │ 右:該 Topic 最高三篇│
//   └──────────────────────────────┴────────────────────┘
//
//   · 左欄 = 主題介紹:名次 → 國旗 → 標題 → 分類/長青徽章 → 一行摘要 → 熱度級距。
//     名次來自 rankings/global/<win>.json;熱度只給級距,原始分數不上畫面(見 src/lib/heat.mjs)。
//   · 右欄 = 該 Topic 熱度最高的三篇(TopicPosts,sort=hot)。Topic 底下本來就掛著該議題的
//     討論串(World → Topic → Post → Comment),所以每一列都要看得到它。
//   · 窄螢幕自然堆疊成上下(先左欄再右欄),≥1024px 才真的分兩欄——斷點只用 min-width。
//
// 貼文區塊放在整列連結**之外**(a 裡不能再包 a),仍在同一個 <li> 裡,階層才對得上。
import { t, tOr } from '../lib/i18n.mjs';
import { withBase } from '../lib/paths.mjs';
import { countryFlag } from '../lib/format.mjs';
import { coverPath, coverThumbPath } from '../lib/data.mjs';
import { isTrendTopic } from '../lib/topic-status.mjs';
import { emphasisParts } from '../lib/emphasis.mjs';
import HeatMeter from './HeatMeter.astro';
import TopicPosts from './TopicPosts.astro';

interface Props {
  topic: Record<string, any>;
  rank?: number | null;
  win?: string;
  marker?: string | null;
  // 該排序特有的計數(附近訊息 = 地點數、活動資訊 = 活動場次)。標籤在前、數字在後,
  // 才不必為七語系處理單複數。
  tags?: Array<{ label: string; value: string | number }>;
  // 該排序特有的一行說明(當令的國家與日期、最近一場活動的時間…)
  note?: string | null;
}
// eager:首屏前幾列的 cover 不做 lazy(lazy 的 LCP 元素會拖到 30 秒等級,2026-08-15 Lighthouse 實測)
const { topic, rank = null, win = '24h', marker = null, tags = [], note = null, eager = false } = Astro.props;
const codes = (topic.country_codes || []).slice(0, 8);
const tiers = topic.tiers || {};
const topicHref = withBase(`topic/${topic.slug}/`);
const coverRel = coverPath(topic.slug);
const coverSrc = coverRel ? withBase(coverRel) : null;
const coverThumbRel = coverThumbPath(topic.slug);
const coverThumbSrc = coverThumbRel ? withBase(coverThumbRel) : null;
// 沒有 topic_id 就打不到 /v1/topics/:id/feed(:id 是 ULID 不是 slug),那一列只出左欄。
const withPosts = !!topic.topic_id;
---

<li class:list={['row', { 'row--flush': rank === null }]} data-topic-id={topic.topic_id || undefined}>
  <a class="row-link" data-topic-slug={topic.slug} href={topicHref}>
    {rank !== null && <span class="row-rank" aria-hidden="true">{rank}</span>}
    <span class="row-main">
      {coverSrc && (
        <span class="row-cover" aria-hidden="true">
          <picture>
            {coverThumbSrc && <source srcset={coverThumbSrc} type="image/webp" />}
            <img src={coverSrc} alt="" width="480" height="270" sizes="(max-width: 767px) 112px, (max-width: 1023px) 144px, 192px" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
          </picture>
        </span>
      )}
      <span class="row-copy">
        <span class="row-head">
          {codes.length > 0 && (
            <span class="row-flags" aria-hidden="true">{codes.map(countryFlag).join(' ')}</span>
          )}
          <span class="row-title">{topic.title}</span>
        </span>
        <span class="row-badges">
          {marker && <span class="badge badge--accent">{marker}</span>}
          {topic.category && (
            <span class="badge badge--primary">
              {tOr(`category.${topic.category}`, topic.category)}
            </span>
          )}
          {topic.is_perennial ? <span class="badge">{t('topic.perennial')}</span> : null}
          {/* 機器 Topic 要看得出來是機器做的(docs/TODO.md「復活前必須先做」)。
              判準是輸出層契約 topic_kind,不是 category —— category 是主題分類軸。
              給 title 是因為徽章只有兩三個字,說不完「沒有經過人工查證」這件事。 */}
          {isTrendTopic(topic) && (
            <span class="badge badge--machine" title={t('topic.machine_made_note')}>
              {t('topic.machine_made')}
            </span>
          )}
          {tags.map((tag) => (
            <span class="badge">
              {tag.label}
              <span class="row-tag-value">{tag.value}</span>
            </span>
          ))}
        </span>
        {note && <span class="row-note">{note}</span>}
        {topic.summary && (
          <span class="row-summary">
            {emphasisParts(topic.summary).map((part) => (
              part.strong ? <strong>{part.text}</strong> : <Fragment>{part.text}</Fragment>
            ))}
          </span>
        )}
      </span>
    </span>
    <span class="row-heat">
      <HeatMeter tier={tiers[win]} caption={t(`rankings.window.${win}`)} />
    </span>
  </a>
  {withPosts && (
    <div class="row-thread">
      <TopicPosts topicId={topic.topic_id} topicHref={topicHref} />
    </div>
  )}
</li>

<style>
  /* 一列 = 一個 grid。窄螢幕單欄(左欄在上、貼文在下),≥1024px 才真的左右並排。 */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-block-start: 0.0625rem solid var(--color-line);
  }
  .row:first-child {
    border-block-start: 0.125rem solid var(--color-text);
  }
  .row-link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 0.875rem;
    align-items: baseline;
    padding-block: 1rem;
    text-decoration: none;
    color: var(--color-text);
  }
  .row-link:hover .row-title {
    color: var(--color-accent-dark);
    text-decoration: underline;
  }
  .row-rank {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
    grid-row: span 2;
  }
  .row-main {
    display: grid;
    grid-template-columns: minmax(7rem, 12rem) minmax(0, 1fr);
    gap: 0.35rem;
    min-width: 0;
    align-items: start;
  }
  .row-cover {
    display: block;
    aspect-ratio: 1200 / 675;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-primary-soft);
  }
  .row-cover picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .row-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .row-copy {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .row-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
  }
  /* 國旗列:字元本身就是內容,給它比內文大一階,才看得出「這個議題涵蓋哪些國家」 */
  /* 一面國旗一個 <span> 時,清單頁光是這一列就佔掉全頁元素的一成多(七面 × 每張卡),
     而它整段是 aria-hidden 的純裝飾 —— 爬蟲與螢幕閱讀器都看不到,拆成元素只是白付
     排版成本。改成一個 span 裝一串 emoji,間距用字元空白撐(**不能用 letter-spacing**:
     國旗是兩個 regional indicator 組成的,字距會插進中間把旗子拆散)。
     `nowrap` 是為了保留原本 inline-flex 不換行的行為。 */
  .row-flags {
    display: inline-block;
    white-space: nowrap;
    /* 空白字元本身約 0.25em,比原本的 gap 0.15em 寬一點,用 word-spacing 收回來。
       只影響空白字元,不會像 letter-spacing 那樣插進國旗的兩個 code point 中間。 */
    word-spacing: -0.1em;
    font-size: var(--text-lg);
    line-height: 1;
  }
  .row-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-primary);
  }
  .row-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .row-tag-value {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }
  /* 該排序為什麼收錄這一則(當令的國家日期、最近一場活動…) */
  .row-note {
    font-size: var(--text-xs);
    color: var(--color-accent-dark);
  }
  .row-summary {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    max-width: 46rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .row-heat {
    grid-column: 2;
  }
  /* 沒有名次的列(今天的議題)不留名次欄,否則第一欄的 auto 會把標題壓成一字一行 */
  .row--flush .row-link {
    grid-template-columns: minmax(0, 1fr);
  }
  .row--flush .row-heat {
    grid-column: 1;
  }

  /* 中寬度(768–1023):還是上下堆疊,但貼文縮到標題那一欄下方,
     讓「這些貼文屬於上面那個看板」看得出來。
     窄螢幕不縮排:寬度本來就不夠,再縮排只會把貼文擠成一字一行。 */
  @media (min-width: 768px) {
    .row-thread {
      margin-inline-start: 3rem;
    }
    .row-link {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
      padding-block: 1.25rem;
    }
    .row--flush .row-link {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .row-rank {
      font-size: var(--text-xl);
      grid-row: auto;
    }
    .row-heat {
      grid-column: auto;
      justify-self: end;
    }
    .row-title {
      font-size: var(--text-xl);
    }
    .row-main {
      grid-template-columns: minmax(9rem, 12rem) minmax(0, 1fr);
    }
  }

  /* 桌機:左欄主題介紹 / 右欄該 Topic 最高的三篇,水平並排。
     左欄變窄了,所以熱度級距收回標題底下靠右(就是草案版面那一格),不再跟標題搶同一行。 */
  @media (min-width: 1024px) {
    .row {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      column-gap: clamp(1.25rem, 3vw, 2.5rem);
      align-items: start;
    }
    .row-link {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
    .row--flush .row-link {
      grid-template-columns: minmax(0, 1fr);
    }
    .row-heat {
      grid-column: 2;
      justify-self: end;
    }
    .row--flush .row-heat {
      grid-column: 1;
    }
    .row-thread {
      margin-inline-start: 0;
      padding-block-start: 1.25rem;
    }
  }
</style>
