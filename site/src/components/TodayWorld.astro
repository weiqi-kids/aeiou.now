---
// 「今天的世界」:純靜態、無 JS(§6.3)。資料來自 lib/data.mjs 的 todayWorld()——
// topics index + facts.json observances[].occurrences,依國家分組、依距今天數排序,
// 最多 8 國、每國最多 3 項。這裡的國家是內容裡的國家(節日辦在哪國),與投票的
// 語言社群判定無關,允許出現。
import { t } from '../lib/i18n.mjs';
import { withBase } from '../lib/paths.mjs';
import { countryName } from '../lib/data.mjs';
import { countryFlag, calendarDate } from '../lib/format.mjs';

interface Props {
  countries: Array<{
    country_code: string;
    items: Array<{
      topic_id: string;
      slug: string;
      title: string;
      local_name: string | null;
      starts_on: string;
      ends_on: string | null;
    }>;
  }>;
  heading: string;
}

const { countries, heading } = Astro.props;
---

<section class="tw">
  <h2 class="tw-heading">{heading}</h2>
  {countries.length === 0 ? (
    <p class="tw-empty">{t('q.today_world_empty')}</p>
  ) : (
    <ul class="tw-countries">
      {countries.map((country) => (
        <li class="tw-country">
          <p class="tw-country-name">
            <span aria-hidden="true">{countryFlag(country.country_code)}</span> {countryName(country.country_code)}
          </p>
          <ul class="tw-items">
            {country.items.map((item) => (
              <li class="tw-item">
                {/* 連結文字用**那一天的名字**(local_name),不是 Topic 標題。
                    2026-08-27:首頁同時有這個「今天的世界」區塊與底下的 Topic 清單,
                    兩邊都印 Topic 標題 = 同一段文字在同一頁出現兩次,en build 被
                    check-rendered-depth 的 D3 擋下(門檻 40 字元,短的 CJK 標題一直躲過)。
                    修法不是砍區塊(版面的權威是產品草案,§55 明訂首頁必須有「現在」),
                    而是讓這一區印它本來就該印的東西:今天正在發生的**那個日子**。
                    沒有 local_name 時才退回 Topic 標題。 */}
                <a href={withBase(`topic/${item.slug}/`)}>{item.local_name || item.title}</a>
                <span class="tw-date">
                  {' · '}
                  {item.ends_on ? `${calendarDate(item.starts_on)} – ${calendarDate(item.ends_on)}` : calendarDate(item.starts_on)}
                </span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .tw {
    border: 0.0625rem solid var(--color-line);
    border-block-start: 0.25rem solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: clamp(1.25rem, 4vw, 2rem);
    background: var(--color-white);
    box-shadow: var(--shadow-card);
  }
  .tw-heading {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }
  .tw-empty {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .tw-countries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .tw-country-name {
    margin: 0 0 0.35rem;
    font-size: var(--text-base);
    font-weight: 700;
  }
  .tw-items {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.25rem;
    display: grid;
    gap: 0.3rem;
  }
  .tw-item {
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  .tw-item a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .tw-item a:hover {
    text-decoration: underline;
  }
  .tw-date {
    color: var(--color-ink-muted);
  }
</style>
