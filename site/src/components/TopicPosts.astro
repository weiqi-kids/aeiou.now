---
// 首頁每個 Topic 底下掛的 N 則 Post(2026-08-11 用戶指正的階層:
// World → Topic(看板) → Post(討論串) → Comment)。
//
// 四個排序頁(全球熱門 = 首頁 / 熱門話題 / 附近訊息 / 活動資訊)列的都是 Topic 清單,而 Topic
// 不是一條光禿禿的標題:那個議題裡正在被討論的貼文本來就屬於它底下,所以每一列都是
// 「左邊主題介紹、右邊該 Topic 最高的三篇」,不另開一區把同一批資料重排一次
// ——同一批資料在同一頁出現兩次就是階層沒分清楚(這一輪刪掉 #talking 的理由)。
//
// 資料來源是**現有端點**:GET /v1/topics/:id/feed?sort=hot&limit=3&comments=0
//   · sort=hot  → 用戶指正(2026-08-11):右欄要的是該 Topic「最高的三篇」,不是最新的三篇。
//                 hot 的 M1 定義見 api-contract §1:reactions 的 distinct actor 數 + comments,
//                 tie-break created_at DESC(不是 posts.hot_score,那個 M1 恆 0)。
//   · limit=3   → 每個看板露 3 則,列表頁不是討論頁,要進去才看全部
//   · comments=0→ 清單頁不列留言內容,只給留言總數(comment_count 與 comments 陣列是兩回事)
// 沒有新增任何端點、沒有動 Worker。
//
// 降級模型(與 DiscussionRoom 一致,不可動):
//   · fetch 成功且解析出 posts 陣列才切 "open";任何失敗切 "unavailable",
//     不顯示過期資料、不做 fallback 快照
//   · 一律 credentials: 'include'(anon_id 是跨站 cookie)
//   · 使用者內容一律 textContent / createTextNode,絕不 innerHTML
//
// 「載入中」「拿不到」「空」是三件事,不可混用(用戶 2026-08-11、2026-08-20 三次指正):
//   · 載入中     data-room-state="loading"     = **靜態預設值**,也是 fetch 還沒回來的狀態
//   · 拿不到     data-room-state="unavailable" = fetch 失敗/非 2xx/JSON 壞/未設 API 位址
//   · 空                                        = fetch **成功**但 posts 為 0 筆 → 容器照樣 "open",
//                                                 改印「還沒有人在這個議題發言」+ 進 Topic 頁的入口
//
// ⚠ 2026-08-20 修正(用戶:「實際上沒有關閉啊」):靜態預設值原本是 closed,
//   於是首頁與三個清單頁上,**每一張 Topic 卡都印一行「討論室暫時關閉」**——
//   一頁 30 次,對一個從未關閉過的討論室。不執行 JS 的爬蟲看到的因此是一整頁關著的論壇。
//   現在靜態預設值是 loading(資料還沒到,是事實),沒有 JS 的讀者由 <noscript> 收尾。
//
// 譯文規則照 api-contract §1:original_locale === LOCALE 直接顯示 content;
// 有 translations[LOCALE] 顯示譯文;缺席顯示原文 + 「翻譯中」。
//
// emoji 照 REACTION_SET 七顆全渲染(缺席顯示 0),而且**是可以按的**(用戶 2026-08-11 指示)。
// 行為與 Topic 頁討論室共用同一份實作 src/lib/reactions.mjs(契約 §4 POST /v1/reactions),
// 兩處不可以有兩種行為。feed 自 2026-08-21 起回 mine(契約 §1),載入時的已按狀態就是對的。
import { t } from '../lib/i18n.mjs';
import { LOCALE, REACTION_SET } from '../lib/config.mjs';

interface Props {
  topicId: string; // API 路徑參數是 topic_id(ULID),不是 slug
  topicHref: string; // M1 沒有單則貼文頁,點貼文一律回該 Topic 頁
}
const { topicId, topicHref } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL || '';

const postsConfig = {
  locale: LOCALE,
  href: topicHref,
  reactions: REACTION_SET,
  i18n: {
    // 「空」狀態專用文案:room.empty 是討論室(8H 視窗)的說法,語意對不上看板列的空欄,
    // 所以另開 key,不硬借。
    noPosts: t('room.no_posts'),
    beFirst: t('room.be_first'),
    translating: t('post.translating'),
    viewTopic: t('room.view_topic'),
    reactionLabel: t('reaction.label'),
    reactionFailed: t('reaction.failed'),
  },
};
// </script> 防拆:JSON 內任何 "<" 都轉義
const postsConfigJson = JSON.stringify(postsConfig).replace(/</g, '\\u003c');
---

<div
  class="posts"
  data-posts
  data-room-state="loading"
  data-topic-id={topicId}
  data-api-url={apiUrl}
>
  <script type="application/json" data-posts-config set:html={postsConfigJson} />
  <!-- 載入中 = 靜態預設值(2026-08-20,見檔頭)。骨架條純裝飾 -->
  <div class="posts-loading">
    <div class="posts-skeleton" aria-hidden="true">
      <span class="posts-skeleton-bar"></span>
      <span class="posts-skeleton-bar"></span>
    </div>
  </div>
  <!-- 沒有 JS 的讀者:載入中不會結束,藏掉；主題摘要本身已經是完整的靜態內容。 -->
  <noscript>
    <style>.posts-loading { display: none; }</style>
  </noscript>
  <div class="posts-live" hidden></div>
</div>

<script>
  import { createReactions } from '../lib/reactions.mjs';
  import { renderMarkdown } from '../lib/markdown.mjs';

  // 狀態切換集中在這一支(loading / open / unavailable),免得各處各自 hidden 一半。
  function setPostsState(root, state) {
    const loading = root.querySelector('.posts-loading');
    const live = root.querySelector('.posts-live');
    if (loading) loading.hidden = state !== 'loading';
    if (live) live.hidden = state !== 'open';
    // unavailable = 整塊安靜收掉(2026-08-28 用戶拍板)。
    // 這一支長在首頁與三個清單頁的每一張 Topic 卡上,API 一掛就會**每張卡各印一次故障**
    // —— 那正是 2026-08-20 事故的形狀(一頁 30 次)。所以卡片層不出聲,
    // 由 Topic 頁自己的 DiscussionRoom 負責誠實說「討論室暫時無法載入」。
    // ⚠ 因此**不要**再加「unavailable 時顯示某段文字」的分支:root 一 hidden 就永遠印不出來。
    //   同一輪已清掉 .posts-closed-title / .posts-closed-hint 兩條沒有標記使用它的死 CSS。
    root.hidden = state === 'unavailable';
    root.dataset.roomState = state;
  }

  function el(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text; // 使用者內容只走 textContent
    return node;
  }

  function fmtTime(epochSec, locale) {
    try {
      return new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeStyle: 'short' })
        .format(new Date(epochSec * 1000));
    } catch {
      return new Date(epochSec * 1000).toISOString();
    }
  }

  function pickText(post, locale) {
    if (post.original_locale === locale) return { text: post.content, pending: false };
    const tr = post.translations && post.translations[locale];
    if (tr) return { text: tr, pending: false };
    return { text: post.content, pending: true }; // 缺譯:原文 + 翻譯中
  }

  function renderPost(post, cfg, api) {
    const item = el('article', 'post');

    const origin = [post.country_code, post.city_code].filter(Boolean).join(' · ');
    const when = fmtTime(post.created_at, cfg.locale);
    item.appendChild(el('p', 'post-meta', origin ? origin + ' · ' + when : when));

    const picked = pickText(post, cfg.locale);
    // Markdown 安全子集(契約 §1)。renderMarkdown 回的是 **DOM 節點**,一個字元都不經過
    // innerHTML —— 使用者寫的 <script> 會變成一個文字節點,螢幕上就是那六個字。
    // 見 src/lib/markdown.mjs 檔頭:安全性來自結構,不是黑名單。
    const body = el('div', 'post-content');
    renderMarkdown(picked.text).forEach((node) => body.appendChild(node));
    item.appendChild(body);
    if (picked.pending) item.appendChild(el('p', 'post-note', cfg.i18n.translating));

    const stats = el('p', 'post-stats');
    const talk = el('span', 'post-comments');
    talk.append(
      el('span', 'post-comments-icon', '💬'),
      el('span', 'post-comments-count', String(post.comment_count || 0))
    );
    stats.appendChild(talk);

    // 七顆 emoji:同一列裡的真按鈕(共用 src/lib/reactions.mjs,行為同討論室)
    const reactions = createReactions({
      targetType: 'post',
      targetId: post.post_id,
      emojis: cfg.reactions,
      counts: post.reactions,
      mine: post.mine,
      api: api,
      i18n: { label: cfg.i18n.reactionLabel, failed: cfg.i18n.reactionFailed },
      classes: {
        btn: 'post-reaction',
        emoji: 'post-reaction-emoji',
        count: 'post-reaction-count',
        status: 'post-reaction-status',
        mine: 'is-mine',
        error: 'is-error',
      },
    });
    reactions.nodes.forEach((node) => stats.appendChild(node));
    item.appendChild(stats);

    const more = el('a', 'post-link', cfg.i18n.viewTopic);
    more.href = cfg.href; // M1 沒有單則貼文頁 → 連回該 Topic 頁
    item.appendChild(more);

    return item;
  }

  // fetch 成功但這個看板一則貼文都沒有:講清楚是「沒有人發言」而不是「壞掉」,
  // 並給一個進該 Topic 頁發言的入口(連的是這一列自己的 Topic,不串台)。
  function renderEmpty(cfg) {
    const box = el('div', 'posts-empty');
    box.appendChild(el('p', 'posts-empty-text', cfg.i18n.noPosts));
    const cta = el('a', 'post-link', cfg.i18n.beFirst);
    cta.href = cfg.href;
    box.appendChild(cta);
    return box;
  }

  function initPosts(root) {
    const api = root.dataset.apiUrl;
    const topicId = root.dataset.topicId;
    // PUBLIC_API_URL 未設:完全不發 fetch。**要明確切到 unavailable**——
    // 靜態預設值已經是 loading,直接 return 會讓卡片永遠停在「載入中」。
    if (!api || !topicId) { setPostsState(root, 'unavailable'); return; }

    let cfg;
    try {
      cfg = JSON.parse(root.querySelector('[data-posts-config]').textContent);
    } catch {
      setPostsState(root, 'unavailable'); // 設定壞掉:同理,不能停在 loading
      return;
    }

    setPostsState(root, 'loading');

    const url = api + '/v1/topics/' + topicId + '/feed?sort=hot&limit=3&comments=0';
    fetch(url, { credentials: 'include' })
      .then((res) => {
        if (!res.ok) throw new Error('http ' + res.status);
        return res.json();
      })
      .then((data) => {
        if (!data || !Array.isArray(data.posts)) throw new Error('bad shape');
        const live = root.querySelector('.posts-live');
        if (!live) return;
        live.textContent = '';
        if (data.posts.length === 0) {
          // 空 ≠ 關閉:動態層是好的,只是這個看板還沒有人發言 → 印空狀態 + 進 Topic 頁的入口
          live.appendChild(renderEmpty(cfg));
        } else {
          data.posts.forEach((post) => live.appendChild(renderPost(post, cfg, api)));
        }
        setPostsState(root, 'open'); // 成功解析 posts 陣列後才切 open(空也是 open)
      })
      .catch(() => {
        // 任何失敗退回 closed(不是停在 loading),不顯示過期資料、不做 fallback 快照
        setPostsState(root, 'unavailable');
      });
  }

  // 進 viewport 才發請求(2026-08-22)。原本是載入時每張 Topic 卡各打一次 /feed ——
  // 清單頁(首頁/熱門/附近/活動)的卡數等於當令 Topic 數,實測單次載入是三十幾發並發,
  // 而它們把封面縮圖擠到 1.3 秒之後才開始下載,LCP 直接被自己的討論串請求拖垮。
  // 同一個病、同一個藥:`QuestionCard.astro` 2026-08-21 已經這樣改過。
  //
  // 退場條件寫死成「沒有 IntersectionObserver 就全部照舊立刻發」——降級要是可用的舊行為,
  // 不是永遠停在 loading。rootMargin 給 200px:讀者捲到之前就備好,不會看到明顯的空窗。
  const rooms = Array.prototype.slice.call(document.querySelectorAll('[data-posts]'));
  if (typeof IntersectionObserver !== 'function') {
    rooms.forEach(initPosts);
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          io.unobserve(entry.target); // 一個看板只發一次
          initPosts(entry.target);
        });
      },
      { rootMargin: '200px 0px' },
    );
    rooms.forEach((room) => io.observe(room));
  }
</script>

<style>
  /* 靠一條主色直線表示「這些貼文屬於旁邊(窄螢幕是上面)那個看板」。
     兩欄並排時它同時當左右欄的分界;直線變灰 = 這一次拿不到資料。 */
  .posts {
    border-inline-start: 0.1875rem solid var(--color-accent);
    padding: 0.25rem 0 0.75rem 0.875rem;
    margin-block-end: 1rem;
  }
  .posts-noscript {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  /* 載入中:邊線維持中性(還不知道結果),不長得像錯誤 */
  .posts[data-room-state='loading'] {
    border-inline-start-color: var(--color-line-strong);
  }
  .posts-loading-text {
    margin: 0 0 0.4rem;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
  .posts-skeleton {
    display: grid;
    gap: 0.4rem;
    max-inline-size: 26rem;
  }
  .posts-skeleton-bar {
    display: block;
    block-size: 0.875rem;
    border-radius: var(--radius-sm);
    background: var(--color-line);
    animation: posts-skeleton-pulse 1.4s ease-in-out infinite;
  }
  .posts-skeleton-bar:nth-child(2) {
    inline-size: 68%;
    animation-delay: 0.15s;
  }
  @keyframes posts-skeleton-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .posts-skeleton-bar {
      animation: none;
    }
  }
  .posts :global(.post) {
    padding-block: 0.625rem;
  }
  .posts :global(.post + .post) {
    border-block-start: 0.0625rem solid var(--color-line);
  }
  .posts :global(.post-meta) {
    margin: 0 0 0.25rem;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
  /* 同 DiscussionRoom:本體是 Markdown 安全子集產生的區塊,不再是單一 <p>。 */
  .posts :global(.post-content) {
    margin: 0 0 0.35rem;
    font-size: var(--text-base);
    overflow-wrap: break-word;
  }
  .posts :global(.post-content > :first-child) { margin-block-start: 0; }
  .posts :global(.post-content > :last-child) { margin-block-end: 0; }
  .posts :global(.post-content p) { margin: 0 0 0.35rem; }
  .posts :global(.post-content ul),
  .posts :global(.post-content ol) { margin: 0 0 0.35rem; padding-inline-start: 1.4rem; }
  .posts :global(.post-content blockquote) {
    margin: 0 0 0.35rem;
    padding-inline-start: 0.6rem;
    border-inline-start: 0.1875rem solid var(--color-line-strong);
    color: var(--color-ink-soft);
  }
  .posts :global(.post-content code) {
    font-family: ui-monospace, monospace;
    font-size: 0.95em;
    background: var(--color-bg-light);
    padding: 0.05em 0.35em;
  }
  .posts :global(.post-note) {
    margin: 0 0 0.35rem;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
  /* 留言數與七顆 emoji 的計數:一律折行,窄螢幕不橫捲 */
  .posts :global(.post-stats) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0 0 0.35rem;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
  .posts :global(.post-comments) {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2rem;
  }
  .posts :global(.post-comments-count),
  .posts :global(.post-reaction-count) {
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-soft);
  }
  /* 七顆 emoji 是真按鈕:看得出可按(藥丸外框 + 指標),但用量克制,
     不能把看板列變成一排大按鈕。按下狀態走 aria-pressed,不是只靠 class。 */
  .posts :global(.post-reaction) {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    line-height: 1.3;
    padding: 0.1rem 0.5rem;
    border: 0.0625rem solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-white);
    color: var(--color-ink-muted);
  }
  /* 可按的樣子只給真的 <button>:PUBLIC_API_URL 未設時退成 <span>,不做成看似可按 */
  .posts :global(button.post-reaction) {
    cursor: pointer;
  }
  .posts :global(button.post-reaction:hover:not(:disabled)) {
    border-color: var(--color-primary-line);
  }
  .posts :global(.post-reaction[aria-pressed='true']) {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .posts :global(.post-reaction[aria-pressed='true'] .post-reaction-count) {
    color: var(--color-accent-dark);
    font-weight: 700;
  }
  /* 送出中:同一顆按鈕 disable(連點只送一次),外觀要看得出「正在處理」 */
  .posts :global(.post-reaction:disabled) {
    cursor: progress;
    opacity: 0.55;
  }
  /* 失敗:不假裝成功——按鈕短暫改成警示外框,旁邊同時出現一行文字(role=status) */
  .posts :global(.post-reaction.is-error) {
    border-color: var(--color-accent-dark);
    border-style: dashed;
  }
  .posts :global(.post-reaction-status) {
    font-size: var(--text-xs);
    color: var(--color-accent-dark);
  }
  .posts :global(.post-link) {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent-dark);
    text-decoration: none;
  }
  .posts :global(.post-link:hover) {
    text-decoration: underline;
  }
  /* 空狀態(fetch 成功、0 筆):容器仍是 open,所以邊線維持主色,只有字是弱化的 */
  .posts :global(.posts-empty) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding-block: 0.625rem;
  }
  .posts :global(.posts-empty-text) {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
</style>
