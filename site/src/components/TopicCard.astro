---
// 首頁的議題卡。lead=true 是頭條規格(大字、摘要放大、跨欄),其餘是次條。
// 卡片上的資訊順序 = 這個站的敘事順序:分類 → 標題 → 摘要 → 涵蓋哪些國家 → 熱度級距。
import { t, tOr } from '../lib/i18n.mjs';
import { countryName } from '../lib/data.mjs';
import { withBase } from '../lib/paths.mjs';
import HeatMeter from './HeatMeter.astro';

interface Props {
  topic: Record<string, any>;
  lead?: boolean;
}
const { topic, lead = false } = Astro.props;
const scores = topic.scores || {};
const codes = topic.country_codes || [];
const shown = codes.slice(0, 4);
const rest = codes.length - shown.length;
---

<article class:list={['card', { lead }]}>
  <a class="card-link" href={withBase(`topic/${topic.slug}/`)}>
    <ul class="badge-row">
      {topic.category && (
        <li><span class="badge badge--primary">{tOr(`category.${topic.category}`, topic.category)}</span></li>
      )}
      {topic.is_perennial ? <li><span class="badge">{t('topic.perennial')}</span></li> : null}
    </ul>

    <h2 class="card-title">{topic.title}</h2>
    {topic.summary && <p class="card-summary">{topic.summary}</p>}

    {shown.length > 0 && (
      <p class="card-countries">
        <span class="card-countries-label">{t('topic.countries_label')}</span>
        <span class="card-countries-names">
          {shown.map((code) => countryName(code)).join(' · ')}{rest > 0 ? ` +${rest}` : ''}
        </span>
      </p>
    )}

    <p class="card-foot">
      <HeatMeter score={scores['24h']} caption={t('rankings.window.24h')} size={lead ? 'md' : 'sm'} />
      <span class="card-more" aria-hidden="true">→</span>
    </p>
  </a>
</article>

<style>
  .card {
    background: var(--color-white);
    border: 0.0625rem solid var(--color-line);
    border-block-start: 0.1875rem solid var(--color-primary);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-0.125rem);
  }
  .card.lead {
    border-block-start-color: var(--color-accent);
  }
  /* flex column + foot 靠 margin-block-start:auto:同一列的卡片不管內容多寡,
     熱度列都對齊在底部,頭條卡不會拖出一片空白 */
  .card-link {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    color: var(--color-text);
    text-decoration: none;
    height: 100%;
  }
  .card-title {
    font-size: var(--text-lg);
    margin: 0.75rem 0 0.5rem;
    color: var(--color-primary);
    line-height: 1.25;
  }
  .card-summary {
    margin: 0 0 1rem;
    color: var(--color-ink-soft);
    font-size: var(--text-base);
    max-width: 42rem;
  }
  .card-countries {
    margin: 0 0 1rem;
    font-size: var(--text-xs);
    line-height: 1.5;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    align-items: baseline;
    border-block-start: 0.0625rem solid var(--color-line);
    padding-block-start: 0.75rem;
  }
  .card-countries-label {
    color: var(--color-ink-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .card-countries-names {
    color: var(--color-text);
    font-weight: 600;
  }
  .card-foot {
    margin: auto 0 0;
    padding-block-start: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .card-more {
    color: var(--color-accent);
    font-size: var(--text-sm);
  }

  @media (min-width: 768px) {
    .card.lead .card-link {
      padding: 2rem;
    }
    .card.lead .card-title {
      font-size: var(--text-2xl);
    }
    .card.lead .card-summary {
      font-size: var(--text-lg);
      line-height: 1.6;
      color: var(--color-text);
    }
  }
</style>
