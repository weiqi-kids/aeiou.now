node_modules/
dist/
.astro/

# build 時由 copy-data 從根層 data/ 鏡像產生,不進 git
site/src/data/

# 主機 SQLite(權威來源,但不進 git;重建靠 init-db + seed)
*.sqlite
*.sqlite-wal
*.sqlite-shm

# 同步指紋(sync-topics 判斷「內容沒變就不推」用;純本機狀態,刪掉只會多推一次)
db/.sync-state*.json

# 在地資料來源的傳輸層健康計數(update-local-data 用;純本機狀態,刪掉只會讓計數歸零)
db/.local-source-health.json

.DS_Store
.env
.env.*
!.env.example
*.log

# logs/ 底下只保留 .gitkeep:執行期 log 與維運封存(例:清 DLQ 前的 jobs 封存)
# 都是本機營運資料,不進 git。
logs/*
!logs/.gitkeep
.wrangler/

# 視覺驗收截圖(本機產物,不進 git)
.screenshots/
